<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-retrieve-a-page.filter_properties.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-retrieve-a-page.filter_properties.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "A list of page property value IDs associated with the page. Use this param to limit the response to a specific page property value or values. To retrieve multiple properties, specify each page property ID. For example: `?filter_properties=iAk8&filter_properties=b7dh`."^^xsd:string ;
    tool-coupler-ont:hasName "filter_properties"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-retrieve-a-page.filter_properties.> .

