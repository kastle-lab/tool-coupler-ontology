@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study.summaryOnly.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study.summaryOnly.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "If true, returns a condensed summary of the study instead of the full data. Defaults to false."^^xsd:string ;
    tool-coupler-ont:hasName "summaryOnly"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study.summaryOnly.> .

tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study.summaryOnly.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study.summaryOnly.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study.summaryOnly.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study .

