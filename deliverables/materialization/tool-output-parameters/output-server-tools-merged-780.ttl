@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.thread_ts.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_add_message.thread_ts.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Unique identifier of either a thread's parent message or a message in the thread_ts must be the timestamp in format 1234567890.123456 of an existing message with 0 or more replies. Optional, if not provided the message will be added to the channel itself, otherwise it will be added to the thread."^^xsd:string ;
    tool-coupler-ont:hasName "thread_ts"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.thread_ts.> .

tool-coupler-r:tool.slack.slack_conversations_add_message a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.thread_ts.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.thread_ts.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_add_message.thread_ts.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_add_message .

