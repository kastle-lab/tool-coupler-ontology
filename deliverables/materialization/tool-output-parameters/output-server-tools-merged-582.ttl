    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getEvents.q.> .

tool-coupler-r:tool.national-parks.national-parks_getEvents a tool-coupler-ont:Tool ;
