<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getEvents.q.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.national-parks.national-parks_getEvents.q.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search term to filter events by title or description"^^xsd:string ;
