@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.render.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.oxylabs.oxylabs_amazon_search_scraper.render.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Whether a headless browser should be used to render the page.
        For example:
            - 'html' when browser is required to render the page."""^^xsd:string ;
    tool-coupler-ont:hasName "render"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.render.> .

tool-coupler-r:tool.oxylabs.oxylabs_amazon_search_scraper a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.render.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.render.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.oxylabs.oxylabs_amazon_search_scraper.render.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.oxylabs.oxylabs_amazon_search_scraper .

