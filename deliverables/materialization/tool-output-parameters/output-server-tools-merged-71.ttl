<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.arxiv.arxiv_download_paper.paper_id.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.arxiv.arxiv_download_paper.paper_id.> a tool-coupler-ont:Metadata ;
