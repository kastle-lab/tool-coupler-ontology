@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_search_nodes.query.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.memory.memory_search_nodes.query.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The search query to match against entity names, types, and observation content"^^xsd:string ;
    tool-coupler-ont:hasName "query"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_search_nodes.query.> .

tool-coupler-r:tool.memory.memory_search_nodes a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_search_nodes.query.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_search_nodes.query.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.memory.memory_search_nodes.query.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.memory.memory_search_nodes .

