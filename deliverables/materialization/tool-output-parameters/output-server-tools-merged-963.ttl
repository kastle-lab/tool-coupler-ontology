@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_hourly_forecast.hours.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather.weather_get_hourly_forecast.hours.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Number of hours to forecast (1-48, default 24). Provides temperature, conditions, and precipitation probability for each hour."^^xsd:string ;
    tool-coupler-ont:hasName "hours"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_hourly_forecast.hours.> .

tool-coupler-r:tool.weather.weather_get_hourly_forecast a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_hourly_forecast.hours.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_hourly_forecast.hours.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather.weather_get_hourly_forecast.hours.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.weather.weather_get_hourly_forecast .

