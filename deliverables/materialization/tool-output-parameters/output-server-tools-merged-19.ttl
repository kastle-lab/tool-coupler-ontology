@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_list_records.table_name.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.airtable.airtable_list_records.table_name.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Name of the table"^^xsd:string ;
    tool-coupler-ont:hasName "table_name"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_list_records.table_name.> .

tool-coupler-r:tool.airtable.airtable_list_records a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_list_records.table_name.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_list_records.table_name.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.airtable.airtable_list_records.table_name.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.airtable.airtable_list_records .

