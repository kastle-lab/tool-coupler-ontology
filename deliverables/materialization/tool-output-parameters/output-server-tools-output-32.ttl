@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:output.pubmed.pubmed_download_pubmed_pdf.result.Output .

tool-coupler-r:metadata.pubmed.pubmed_download_pubmed_pdf.result.Output a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "result"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:output.pubmed.pubmed_download_pubmed_pdf.result.Output .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:output.pubmed.pubmed_download_pubmed_pdf.result.Output .

tool-coupler-r:tool.pubmed.pubmed_download_pubmed_pdf a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:output.pubmed.pubmed_download_pubmed_pdf.result.Output .

tool-coupler-r:output.pubmed.pubmed_download_pubmed_pdf.result.Output a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.pubmed.pubmed_download_pubmed_pdf.result.Output ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.pubmed.pubmed_download_pubmed_pdf .

