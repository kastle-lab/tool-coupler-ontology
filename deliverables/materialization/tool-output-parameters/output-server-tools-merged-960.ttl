@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_find_weather_stations.limit.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather.weather_find_weather_stations.limit.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Maximum number of stations to return (1-20, default 10). Stations are returned ordered by distance from the specified location."^^xsd:string ;
    tool-coupler-ont:hasName "limit"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_find_weather_stations.limit.> .

tool-coupler-r:tool.weather.weather_find_weather_stations a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_find_weather_stations.limit.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_find_weather_stations.limit.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather.weather_find_weather_stations.limit.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.weather.weather_find_weather_stations .

