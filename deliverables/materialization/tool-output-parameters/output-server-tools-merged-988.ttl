@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.whois.whois_whois_tld.tld.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.whois.whois_whois_tld.tld.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "tld"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.whois.whois_whois_tld.tld.> .

tool-coupler-r:tool.whois.whois_whois_tld a tool-coupler-ont:Tool ;
