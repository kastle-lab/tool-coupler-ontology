@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.payload.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_add_message.payload.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Message payload in specified content_type format. Example: 'Hello, world!' for text/plain or '# Hello, world!' for text/markdown."^^xsd:string ;
    tool-coupler-ont:hasName "payload"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.payload.> .

tool-coupler-r:tool.slack.slack_conversations_add_message a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.payload.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_add_message.payload.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_add_message.payload.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_add_message .

