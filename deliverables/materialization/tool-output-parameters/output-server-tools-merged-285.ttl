@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_get_issue.issue_number.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.github.github_get_issue.issue_number.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The number of the issue"^^xsd:string ;
    tool-coupler-ont:hasName "issue_number"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_get_issue.issue_number.> .

tool-coupler-r:tool.github.github_get_issue a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_get_issue.issue_number.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_get_issue.issue_number.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.github.github_get_issue.issue_number.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_get_issue .

