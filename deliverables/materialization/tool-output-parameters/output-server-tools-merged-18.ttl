<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_list_records.max_records.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.airtable.airtable_list_records.max_records.> a tool-coupler-ont:Metadata ;
