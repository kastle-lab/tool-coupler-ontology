    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_list_records.max_records.> .

tool-coupler-r:tool.airtable.airtable_list_records a tool-coupler-ont:Tool ;
