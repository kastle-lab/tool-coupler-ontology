<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-post-search.start_cursor.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "A `cursor` value returned in a previous response that If supplied, limits the response to results starting after the `cursor`. If not supplied, then the first page of results is returned. Refer to [pagination](https://developers.notion.com/reference/intro#pagination) for more details."^^xsd:string ;
    tool-coupler-ont:hasName "start_cursor"^^xsd:string ;
