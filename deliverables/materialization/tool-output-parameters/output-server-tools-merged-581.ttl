@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getEvents.parkCode.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.national-parks.national-parks_getEvents.parkCode.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter events by park code (e.g., \"yose\" for Yosemite). Multiple parks can be comma-separated (e.g., \"yose,grca\")."^^xsd:string ;
    tool-coupler-ont:hasName "parkCode"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getEvents.parkCode.> .

tool-coupler-r:tool.national-parks.national-parks_getEvents a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getEvents.parkCode.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getEvents.parkCode.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.national-parks.national-parks_getEvents.parkCode.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.national-parks.national-parks_getEvents .

