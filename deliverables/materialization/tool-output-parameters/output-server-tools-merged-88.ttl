@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.analysisType.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.analysisType.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The type of statistical analysis to perform on the study set."^^xsd:string ;
    tool-coupler-ont:hasName "analysisType"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.analysisType.> .

tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.analysisType.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.analysisType.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.analysisType.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends .

