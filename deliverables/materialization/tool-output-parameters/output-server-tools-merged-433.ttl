@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-workspace.google-workspace_search_emails.query.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-workspace.google-workspace_search_emails.query.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Gmail search query (e.g., "from:example@gmail.com has:attachment"). Examples:
- "from:alice@example.com" (Emails from Alice)
- "to:bob@example.com" (Emails sent to Bob)
- "subject:Meeting Update" (Emails with "Meeting Update" in the subject)
- "has:attachment filename:pdf" (Emails with PDF attachments)
- "after:2024/01/01 before:2024/02/01" (Emails between specific dates)
- "is:unread" (Unread emails)
- "from:@company.com has:attachment" (Emails from a company domain with attachments)"""^^xsd:string ;
    tool-coupler-ont:hasName "query"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-workspace.google-workspace_search_emails.query.> .

tool-coupler-r:tool.google-workspace.google-workspace_search_emails a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-workspace.google-workspace_search_emails.query.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.google-workspace.google-workspace_search_emails.query.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-workspace.google-workspace_search_emails.query.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.google-workspace.google-workspace_search_emails .

