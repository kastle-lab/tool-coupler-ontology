@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-page.children.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-post-page.children.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The content to be rendered on the new page, represented as an array of [block objects](https://developers.notion.com/reference/block)."^^xsd:string ;
    tool-coupler-ont:hasName "children"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-page.children.> .

tool-coupler-r:tool.notion.notion_API-post-page a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-page.children.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-page.children.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-post-page.children.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-post-page .

