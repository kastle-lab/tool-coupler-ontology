<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.desktop-commander.desktop-commander_move_file.destination.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.desktop-commander.desktop-commander_move_file.destination.> a tool-coupler-ont:Metadata ;
