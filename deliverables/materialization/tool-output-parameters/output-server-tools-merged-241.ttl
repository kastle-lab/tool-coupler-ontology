@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_create_issue.owner.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.github.github_create_issue.owner.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Repository owner"^^xsd:string ;
    tool-coupler-ont:hasName "owner"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_create_issue.owner.> .

tool-coupler-r:tool.github.github_create_issue a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_create_issue.owner.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.github.github_create_issue.owner.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.github.github_create_issue.owner.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_create_issue .

