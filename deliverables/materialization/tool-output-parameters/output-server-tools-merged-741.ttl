@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_google_search_scraper.geo_location.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.oxylabs.oxylabs_google_search_scraper.geo_location.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """The geographical location that the result should be adapted for.
        Use ISO-3166 country codes.
        Examples:
            - 'California, United States'
            - 'Mexico'
            - 'US' for United States
            - 'DE' for Germany
            - 'FR' for France"""^^xsd:string ;
    tool-coupler-ont:hasName "geo_location"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_google_search_scraper.geo_location.> .

tool-coupler-r:tool.oxylabs.oxylabs_google_search_scraper a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_google_search_scraper.geo_location.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_google_search_scraper.geo_location.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.oxylabs.oxylabs_google_search_scraper.geo_location.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.oxylabs.oxylabs_google_search_scraper .

