@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_translate.adapt_to.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.lara-translate.lara-translate_translate.adapt_to.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "A list of translation memory IDs for adapting the translation."^^xsd:string ;
    tool-coupler-ont:hasName "adapt_to"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_translate.adapt_to.> .

tool-coupler-r:tool.lara-translate.lara-translate_translate a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_translate.adapt_to.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_translate.adapt_to.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.lara-translate.lara-translate_translate.adapt_to.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_translate .

