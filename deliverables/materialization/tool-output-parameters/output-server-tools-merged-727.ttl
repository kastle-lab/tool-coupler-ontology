@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.domain.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.oxylabs.oxylabs_amazon_search_scraper.domain.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Domain localization for Google.
        Use country top level domains.
        For example:
            - 'co.uk' for United Kingdom
            - 'us' for United States
            - 'fr' for France"""^^xsd:string ;
    tool-coupler-ont:hasName "domain"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.domain.> .

tool-coupler-r:tool.oxylabs.oxylabs_amazon_search_scraper a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.domain.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_amazon_search_scraper.domain.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.oxylabs.oxylabs_amazon_search_scraper.domain.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.oxylabs.oxylabs_amazon_search_scraper .

