@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.raw.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.fetch.fetch_fetch.raw.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get the actual HTML content of the requested page, without simplification."^^xsd:string ;
    tool-coupler-ont:hasName "raw"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.raw.> .

tool-coupler-r:tool.fetch.fetch_fetch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.raw.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.raw.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.fetch.fetch_fetch.raw.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.fetch.fetch_fetch .

