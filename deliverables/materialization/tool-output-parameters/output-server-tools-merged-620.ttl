<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-page.cover.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-post-page.cover.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The cover image of the new page, represented as a [file object](https://developers.notion.com/reference/file-object)."^^xsd:string ;
    tool-coupler-ont:hasName "cover"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-page.cover.> .

tool-coupler-r:tool.notion.notion_API-post-page a tool-coupler-ont:Tool ;
