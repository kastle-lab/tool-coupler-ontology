<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_delete_relations.relations.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.memory.memory_delete_relations.relations.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "An array of relations to delete"^^xsd:string ;
