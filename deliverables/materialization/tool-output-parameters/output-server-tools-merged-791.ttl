@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_date_after.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_search_messages.filter_date_after.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter messages sent after a specific date in format 'YYYY-MM-DD'. Example: '2023-10-01', 'July', 'Yesterday' or 'Today'. If not provided, all dates will be searched."^^xsd:string ;
    tool-coupler-ont:hasName "filter_date_after"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_date_after.> .

tool-coupler-r:tool.slack.slack_conversations_search_messages a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_date_after.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_date_after.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_search_messages.filter_date_after.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_search_messages .

