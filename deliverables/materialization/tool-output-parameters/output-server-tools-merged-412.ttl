<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_reverse_geocode.latitude.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_reverse_geocode.latitude.> a tool-coupler-ont:Metadata ;
