<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mcp-code-executor.mcp-code-executor_install_dependencies.packages.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mcp-code-executor.mcp-code-executor_install_dependencies.packages.> a tool-coupler-ont:Metadata ;
