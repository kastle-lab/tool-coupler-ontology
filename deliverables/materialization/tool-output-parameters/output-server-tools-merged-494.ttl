    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mcp-code-executor.mcp-code-executor_install_dependencies.packages.> .

tool-coupler-r:tool.mcp-code-executor.mcp-code-executor_install_dependencies a tool-coupler-ont:Tool ;
