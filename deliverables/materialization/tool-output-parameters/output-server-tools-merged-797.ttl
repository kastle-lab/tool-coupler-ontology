@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_threads_only.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_search_messages.filter_threads_only.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "If true, the response will include only messages from threads. Default is boolean false."^^xsd:string ;
    tool-coupler-ont:hasName "filter_threads_only"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_threads_only.> .

tool-coupler-r:tool.slack.slack_conversations_search_messages a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_threads_only.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.filter_threads_only.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_search_messages.filter_threads_only.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_search_messages .

