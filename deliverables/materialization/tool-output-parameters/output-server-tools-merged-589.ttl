@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-create-a-comment.parent.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-create-a-comment.parent.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The page that contains the comment"^^xsd:string ;
    tool-coupler-ont:hasName "parent"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-create-a-comment.parent.> .

tool-coupler-r:tool.notion.notion_API-create-a-comment a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-create-a-comment.parent.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-create-a-comment.parent.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-create-a-comment.parent.> ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-create-a-comment .

