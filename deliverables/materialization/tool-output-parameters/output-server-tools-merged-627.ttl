@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-search.sort.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-post-search.sort.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "A set of criteria, `direction` and `timestamp` keys, that orders the results. The **only** supported timestamp value is `\"last_edited_time\"`. Supported `direction` values are `\"ascending\"` and `\"descending\"`. If `sort` is not provided, then the most recently edited results are returned first."^^xsd:string ;
    tool-coupler-ont:hasName "sort"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-search.sort.> .

tool-coupler-r:tool.notion.notion_API-post-search a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-search.sort.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-search.sort.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-post-search.sort.> ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-post-search .

