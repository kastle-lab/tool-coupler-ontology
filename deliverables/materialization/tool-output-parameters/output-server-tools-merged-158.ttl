@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.exa.exa_web_search_exa.numResults.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.exa.exa_web_search_exa.numResults.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Number of search results to return (default: 5)"^^xsd:string ;
    tool-coupler-ont:hasName "numResults"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.exa.exa_web_search_exa.numResults.> .

tool-coupler-r:tool.exa.exa_web_search_exa a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.exa.exa_web_search_exa.numResults.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.exa.exa_web_search_exa.numResults.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.exa.exa_web_search_exa.numResults.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.exa.exa_web_search_exa .

