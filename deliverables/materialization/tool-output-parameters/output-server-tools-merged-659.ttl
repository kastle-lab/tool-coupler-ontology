<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.osm-mcp-server.osm-mcp-server_analyze_commute.modes.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.osm-mcp-server.osm-mcp-server_analyze_commute.modes.> a tool-coupler-ont:Metadata ;
