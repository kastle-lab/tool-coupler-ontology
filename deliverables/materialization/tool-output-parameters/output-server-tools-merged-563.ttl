@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.update.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_update-many.update.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "An update document describing the modifications to apply using update operator expressions"^^xsd:string ;
    tool-coupler-ont:hasName "update"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.update.> .

tool-coupler-r:tool.mongodb.mongodb_update-many a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.update.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.update.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_update-many.update.> ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_update-many .

