@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_open_nodes.names.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.memory.memory_open_nodes.names.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "An array of entity names to retrieve"^^xsd:string ;
    tool-coupler-ont:hasName "names"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_open_nodes.names.> .

tool-coupler-r:tool.memory.memory_open_nodes a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_open_nodes.names.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.memory.memory_open_nodes.names.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.memory.memory_open_nodes.names.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.memory.memory_open_nodes .

