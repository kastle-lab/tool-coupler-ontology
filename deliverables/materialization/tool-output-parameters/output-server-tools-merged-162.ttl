@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean....Integer..> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.start_index.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.fetch.fetch_fetch.start_index.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "On return output starting at this character index, useful if a previous fetch was truncated and more context is required."^^xsd:string ;
    tool-coupler-ont:hasName "start_index"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.start_index.> .

tool-coupler-r:tool.fetch.fetch_fetch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.start_index.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.fetch.fetch_fetch.start_index.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.fetch.fetch_fetch.start_index.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean....Integer..> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.fetch.fetch_fetch .

