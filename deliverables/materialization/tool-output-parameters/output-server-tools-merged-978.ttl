@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean....Integer..> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather-data.weather-data_weather_forecast.days.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather-data.weather-data_weather_forecast.days.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "days"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather-data.weather-data_weather_forecast.days.> .

tool-coupler-r:tool.weather-data.weather-data_weather_forecast a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather-data.weather-data_weather_forecast.days.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.weather-data.weather-data_weather_forecast.days.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather-data.weather-data_weather_forecast.days.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean....Integer..> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.weather-data.weather-data_weather_forecast .

