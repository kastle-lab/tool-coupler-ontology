@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:output.pubmed.pubmed_get_pubmed_article_metadata.result.Output .

tool-coupler-r:metadata.pubmed.pubmed_get_pubmed_article_metadata.result.Output a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "result"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:output.pubmed.pubmed_get_pubmed_article_metadata.result.Output .

tool-coupler-r:tool.pubmed.pubmed_get_pubmed_article_metadata a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:output.pubmed.pubmed_get_pubmed_article_metadata.result.Output .

tool-coupler-r:output.pubmed.pubmed_get_pubmed_article_metadata.result.Output a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.pubmed.pubmed_get_pubmed_article_metadata.result.Output ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.pubmed.pubmed_get_pubmed_article_metadata .

