@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_rename-collection.newName.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_rename-collection.newName.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The new name for the collection"^^xsd:string ;
    tool-coupler-ont:hasName "newName"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_rename-collection.newName.> .

tool-coupler-r:tool.mongodb.mongodb_rename-collection a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_rename-collection.newName.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_rename-collection.newName.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_rename-collection.newName.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_rename-collection .

