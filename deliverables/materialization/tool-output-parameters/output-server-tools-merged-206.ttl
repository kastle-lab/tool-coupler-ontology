@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.not_contains.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.git.git_git_branch.not_contains.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The commit sha that branch should NOT contain. Do not pass anything to this param if no commit sha is specified"^^xsd:string ;
    tool-coupler-ont:hasName "not_contains"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.not_contains.> .

tool-coupler-r:tool.git.git_git_branch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.not_contains.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.not_contains.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.git.git_git_branch.not_contains.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.git.git_git_branch .

