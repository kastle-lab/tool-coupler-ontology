<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.twelvedata.twelvedata_GetLogo.params.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.twelvedata.twelvedata_GetLogo.params.> a tool-coupler-ont:Metadata ;
