@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_delete_translation.id.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.lara-translate.lara-translate_delete_translation.id.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The ID or list of IDs where to delete the translation unit from. Format: mem_xyz123"^^xsd:string ;
    tool-coupler-ont:hasName "id"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_delete_translation.id.> .

tool-coupler-r:tool.lara-translate.lara-translate_delete_translation a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_delete_translation.id.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_delete_translation.id.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.lara-translate.lara-translate_delete_translation.id.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_delete_translation .

