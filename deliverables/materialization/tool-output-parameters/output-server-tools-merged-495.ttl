@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mcp-code-executor.mcp-code-executor_read_code_file.file_path.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mcp-code-executor.mcp-code-executor_read_code_file.file_path.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Full path to the file to read"^^xsd:string ;
    tool-coupler-ont:hasName "file_path"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mcp-code-executor.mcp-code-executor_read_code_file.file_path.> .

tool-coupler-r:tool.mcp-code-executor.mcp-code-executor_read_code_file a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.mcp-code-executor.mcp-code-executor_read_code_file.file_path.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.mcp-code-executor.mcp-code-executor_read_code_file.file_path.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mcp-code-executor.mcp-code-executor_read_code_file.file_path.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mcp-code-executor.mcp-code-executor_read_code_file .

