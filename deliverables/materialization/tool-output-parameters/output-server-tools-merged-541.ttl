@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_explain.method.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_explain.method.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The method and its arguments to run"^^xsd:string ;
    tool-coupler-ont:hasName "method"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_explain.method.> .

tool-coupler-r:tool.mongodb.mongodb_explain a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_explain.method.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_explain.method.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_explain.method.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_explain .

