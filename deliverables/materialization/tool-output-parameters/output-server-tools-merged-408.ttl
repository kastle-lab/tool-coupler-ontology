@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_distance_matrix.origins.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_distance_matrix.origins.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Array of origin addresses or coordinates"^^xsd:string ;
    tool-coupler-ont:hasName "origins"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_distance_matrix.origins.> .

tool-coupler-r:tool.google-maps.google-maps_maps_distance_matrix a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_distance_matrix.origins.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_distance_matrix.origins.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_distance_matrix.origins.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.google-maps.google-maps_maps_distance_matrix .

