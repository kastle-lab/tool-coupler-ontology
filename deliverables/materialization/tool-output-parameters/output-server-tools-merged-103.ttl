@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_get-library-docs.tokens.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.context7.context7_get-library-docs.tokens.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Maximum number of tokens of documentation to retrieve (default: 10000). Higher values provide more context but consume more tokens."^^xsd:string ;
    tool-coupler-ont:hasName "tokens"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_get-library-docs.tokens.> .

tool-coupler-r:tool.context7.context7_get-library-docs a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_get-library-docs.tokens.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_get-library-docs.tokens.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.context7.context7_get-library-docs.tokens.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.context7.context7_get-library-docs .

