    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_search_places.location.> .

tool-coupler-r:tool.google-maps.google-maps_maps_search_places a tool-coupler-ont:Tool ;
