<https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_search_places.location.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_search_places.location.> ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.google-maps.google-maps_maps_search_places .

