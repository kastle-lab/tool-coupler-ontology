tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_search_places.location.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_search_places.location.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Optional center point for the search"^^xsd:string ;
