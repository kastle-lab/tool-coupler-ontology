<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.oxylabs.oxylabs_google_search_scraper.ad_mode.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.oxylabs.oxylabs_google_search_scraper.ad_mode.> a tool-coupler-ont:Metadata ;
