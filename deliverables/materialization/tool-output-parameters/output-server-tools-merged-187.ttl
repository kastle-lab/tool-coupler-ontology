@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_read_file.tail.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.filesystem.filesystem_read_file.tail.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "If provided, returns only the last N lines of the file"^^xsd:string ;
    tool-coupler-ont:hasName "tail"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_read_file.tail.> .

tool-coupler-r:tool.filesystem.filesystem_read_file a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_read_file.tail.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_read_file.tail.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.filesystem.filesystem_read_file.tail.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.filesystem.filesystem_read_file .

