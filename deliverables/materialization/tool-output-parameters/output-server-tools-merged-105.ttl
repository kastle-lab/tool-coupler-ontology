@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_resolve-library-id.libraryName.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.context7.context7_resolve-library-id.libraryName.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Library name to search for and retrieve a Context7-compatible library ID."^^xsd:string ;
    tool-coupler-ont:hasName "libraryName"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_resolve-library-id.libraryName.> .

tool-coupler-r:tool.context7.context7_resolve-library-id a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_resolve-library-id.libraryName.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.context7.context7_resolve-library-id.libraryName.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.context7.context7_resolve-library-id.libraryName.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.context7.context7_resolve-library-id .

