@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.branch_type.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.git.git_git_branch.branch_type.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Whether to list local branches ('local'), remote branches ('remote') or all branches('all')."^^xsd:string ;
    tool-coupler-ont:hasName "branch_type"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.branch_type.> .

tool-coupler-r:tool.git.git_git_branch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.branch_type.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.git.git_git_branch.branch_type.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.git.git_git_branch.branch_type.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.git.git_git_branch .

