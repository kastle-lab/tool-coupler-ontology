@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.upsert.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_update-many.upsert.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Controls whether to insert a new document if no documents match the filter"^^xsd:string ;
    tool-coupler-ont:hasName "upsert"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.upsert.> .

tool-coupler-r:tool.mongodb.mongodb_update-many a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.upsert.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.mongodb.mongodb_update-many.upsert.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.mongodb.mongodb_update-many.upsert.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_update-many .

