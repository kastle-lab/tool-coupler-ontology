@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-patch-page.icon.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-patch-page.icon.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "A page icon for the page. Supported types are [external file object](https://developers.notion.com/reference/file-object) or [emoji object](https://developers.notion.com/reference/emoji-object)."^^xsd:string ;
    tool-coupler-ont:hasName "icon"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-patch-page.icon.> .

tool-coupler-r:tool.notion.notion_API-patch-page a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-patch-page.icon.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-patch-page.icon.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-patch-page.icon.> ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-patch-page .

