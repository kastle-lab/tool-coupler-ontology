@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_search_places.radius.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_search_places.radius.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search radius in meters (max 50000)"^^xsd:string ;
    tool-coupler-ont:hasName "radius"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_search_places.radius.> .

tool-coupler-r:tool.google-maps.google-maps_maps_search_places a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_search_places.radius.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_search_places.radius.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_search_places.radius.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.google-maps.google-maps_maps_search_places .

