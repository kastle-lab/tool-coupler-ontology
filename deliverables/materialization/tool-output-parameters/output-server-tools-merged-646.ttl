@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-update-a-database.title.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-update-a-database.title.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "An array of [rich text objects](https://developers.notion.com/reference/rich-text) that represents the title of the database that is displayed in the Notion UI. If omitted, then the database title remains unchanged."^^xsd:string ;
    tool-coupler-ont:hasName "title"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-update-a-database.title.> .

tool-coupler-r:tool.notion.notion_API-update-a-database a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-update-a-database.title.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-update-a-database.title.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-update-a-database.title.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-update-a-database .

