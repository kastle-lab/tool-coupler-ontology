@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_weather_forecast.location.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather.weather_get_weather_forecast.location.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "US location as coordinates (lat,lng) in decimal degrees. Example: '40.7128,-74.0060' for New York City. Must be within US boundaries including states, territories (PR, VI, AS, GU, MP), and coastal waters."^^xsd:string ;
    tool-coupler-ont:hasName "location"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_weather_forecast.location.> .

tool-coupler-r:tool.weather.weather_get_weather_forecast a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_weather_forecast.location.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.weather.weather_get_weather_forecast.location.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.weather.weather_get_weather_forecast.location.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.weather.weather_get_weather_forecast .

