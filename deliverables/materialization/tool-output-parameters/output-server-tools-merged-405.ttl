    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.google-maps.google-maps_maps_directions.origin.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.google-maps.google-maps_maps_directions.origin.> a tool-coupler-ont:Metadata ;
