@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.osm-mcp-server.osm-mcp-server_search_category.min_latitude.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.osm-mcp-server.osm-mcp-server_search_category.min_latitude.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "min_latitude"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.osm-mcp-server.osm-mcp-server_search_category.min_latitude.> .

tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_search_category a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.osm-mcp-server.osm-mcp-server_search_category.min_latitude.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.osm-mcp-server.osm-mcp-server_search_category.min_latitude.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.osm-mcp-server.osm-mcp-server_search_category.min_latitude.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_search_category .

