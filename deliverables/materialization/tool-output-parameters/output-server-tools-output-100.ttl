@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:output.twelvedata.twelvedata_GetQuote.currency.Output .

tool-coupler-r:metadata.twelvedata.twelvedata_GetQuote.currency.Output a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Currency in which the equity is denominated"^^xsd:string ;
    tool-coupler-ont:hasName "currency"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:output.twelvedata.twelvedata_GetQuote.currency.Output .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:output.twelvedata.twelvedata_GetQuote.currency.Output .

tool-coupler-r:tool.twelvedata.twelvedata_GetQuote a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:output.twelvedata.twelvedata_GetQuote.currency.Output .

tool-coupler-r:output.twelvedata.twelvedata_GetQuote.currency.Output a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata.twelvedata_GetQuote.currency.Output ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.twelvedata.twelvedata_GetQuote .

