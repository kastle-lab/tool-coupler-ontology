@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-patch-block-children.children.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.notion.notion_API-patch-block-children.children.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Child content to append to a container block as an array of [block objects](ref:block)"^^xsd:string ;
    tool-coupler-ont:hasName "children"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-patch-block-children.children.> .

tool-coupler-r:tool.notion.notion_API-patch-block-children a tool-coupler-ont:Tool ;
