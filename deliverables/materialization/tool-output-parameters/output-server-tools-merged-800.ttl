@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.limit.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_search_messages.limit.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The maximum number of items to return. Must be an integer between 1 and 100."^^xsd:string ;
    tool-coupler-ont:hasName "limit"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.limit.> .

tool-coupler-r:tool.slack.slack_conversations_search_messages a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.limit.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.slack.slack_conversations_search_messages.limit.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.slack.slack_conversations_search_messages.limit.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_search_messages .

