@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_create_field.field.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.airtable.airtable_create_field.field.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "field"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_create_field.field.> .

tool-coupler-r:tool.airtable.airtable_create_field a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_create_field.field.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_create_field.field.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.airtable.airtable_create_field.field.> ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.airtable.airtable_create_field .

