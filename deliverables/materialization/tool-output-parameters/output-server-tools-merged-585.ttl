@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getVisitorCenters.limit.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.national-parks.national-parks_getVisitorCenters.limit.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Maximum number of visitor centers to return (default: 10, max: 50)"^^xsd:string ;
    tool-coupler-ont:hasName "limit"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getVisitorCenters.limit.> .

tool-coupler-r:tool.national-parks.national-parks_getVisitorCenters a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getVisitorCenters.limit.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.national-parks.national-parks_getVisitorCenters.limit.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.national-parks.national-parks_getVisitorCenters.limit.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.national-parks.national-parks_getVisitorCenters .

