@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_import_tmx.tmx_url.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.lara-translate.lara-translate_import_tmx.tmx_url.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "A URL to the tmx file to upload. Don't provide this if you choose to use tmx_content."^^xsd:string ;
    tool-coupler-ont:hasName "tmx_url"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_import_tmx.tmx_url.> .

tool-coupler-r:tool.lara-translate.lara-translate_import_tmx a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_import_tmx.tmx_url.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.lara-translate.lara-translate_import_tmx.tmx_url.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.lara-translate.lara-translate_import_tmx.tmx_url.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_import_tmx .

