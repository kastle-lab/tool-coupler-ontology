@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_edit_file.dryRun.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.filesystem.filesystem_edit_file.dryRun.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Preview changes using git-style diff format"^^xsd:string ;
    tool-coupler-ont:hasName "dryRun"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_edit_file.dryRun.> .

tool-coupler-r:tool.filesystem.filesystem_edit_file a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_edit_file.dryRun.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_edit_file.dryRun.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.filesystem.filesystem_edit_file.dryRun.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.filesystem.filesystem_edit_file .

