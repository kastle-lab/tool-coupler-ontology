@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input.addresses.network .

tool-coupler-r:input.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input.addresses.network .

tool-coupler-r:metadata.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input.addresses.network a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The blockchain network to query. e.g. \"eth-mainnet\" or \"base-mainnet\""^^xsd:string ;
    tool-coupler-ont:hasName "network"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input.addresses.network .

tool-coupler-r:element.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input.addresses.network a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.alchemy.alchemy_fetchTokenPriceByAddress.addresses.Input.addresses.network ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

