@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.memory.memory_create_entities.entities.Input.entities.name .

tool-coupler-r:input.memory.memory_create_entities.entities.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.memory.memory_create_entities.entities.Input.entities.name .

tool-coupler-r:metadata.memory.memory_create_entities.entities.Input.entities.name a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The name of the entity"^^xsd:string ;
    tool-coupler-ont:hasName "name"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.memory.memory_create_entities.entities.Input.entities.name .

tool-coupler-r:element.memory.memory_create_entities.entities.Input.entities.name a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.memory.memory_create_entities.entities.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory.memory_create_entities.entities.Input.entities.name ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

