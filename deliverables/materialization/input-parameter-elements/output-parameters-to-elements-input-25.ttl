@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.filter.geo .

tool-coupler-r:input.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.filter.geo .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.filter.geo a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter results to a geographic area by providing a point and radius."^^xsd:string ;
    tool-coupler-ont:hasName "geo"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.filter.geo .

tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.filter.geo a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.filter.geo ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Object .

