@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input.addresses.address .

tool-coupler-r:input.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input.addresses.address .

tool-coupler-r:metadata.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input.addresses.address a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The wallet address to query. e.g. \"0x1234567890123456789012345678901234567890\""^^xsd:string ;
    tool-coupler-ont:hasName "address"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input.addresses.address .

tool-coupler-r:element.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input.addresses.address a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.addresses.Input.addresses.address ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

