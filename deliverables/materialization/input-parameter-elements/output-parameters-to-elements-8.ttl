@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.airtable.airtable_update_field.updates.Input.name .

tool-coupler-r:input.airtable.airtable_update_field.updates.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.airtable.airtable_update_field.updates.Input.name .

tool-coupler-r:metadata.airtable.airtable_update_field.updates.Input.name a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "New name for the field"^^xsd:string ;
    tool-coupler-ont:hasName "name"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.airtable.airtable_update_field.updates.Input.name .

tool-coupler-r:element.airtable.airtable_update_field.updates.Input.name a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.airtable.airtable_update_field.updates.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable.airtable_update_field.updates.Input.name ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> .

