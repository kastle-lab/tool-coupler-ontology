@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean.....Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.notion.notion_API-patch-block-children.children.Input.bulleted_list_item .

tool-coupler-r:input.notion.notion_API-patch-block-children.children.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.notion.notion_API-patch-block-children.children.Input.bulleted_list_item .

tool-coupler-r:metadata.notion.notion_API-patch-block-children.children.Input.bulleted_list_item a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "bulleted_list_item"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.notion.notion_API-patch-block-children.children.Input.bulleted_list_item .

tool-coupler-r:element.notion.notion_API-patch-block-children.children.Input.bulleted_list_item a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.notion.notion_API-patch-block-children.children.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-patch-block-children.children.Input.bulleted_list_item ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean.....Object .

