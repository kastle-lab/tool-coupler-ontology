@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.memory.memory_add_observations.observations.Input.entityName .

tool-coupler-r:input.memory.memory_add_observations.observations.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.memory.memory_add_observations.observations.Input.entityName .

tool-coupler-r:metadata.memory.memory_add_observations.observations.Input.entityName a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The name of the entity to add the observations to"^^xsd:string ;
    tool-coupler-ont:hasName "entityName"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.memory.memory_add_observations.observations.Input.entityName .

tool-coupler-r:element.memory.memory_add_observations.observations.Input.entityName a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.memory.memory_add_observations.observations.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory.memory_add_observations.observations.Input.entityName ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> .

