@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.memory.memory_delete_relations.relations.Input.to .

tool-coupler-r:input.memory.memory_delete_relations.relations.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.memory.memory_delete_relations.relations.Input.to .

tool-coupler-r:metadata.memory.memory_delete_relations.relations.Input.to a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The name of the entity where the relation ends"^^xsd:string ;
    tool-coupler-ont:hasName "to"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.memory.memory_delete_relations.relations.Input.to .

tool-coupler-r:element.memory.memory_delete_relations.relations.Input.to a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.memory.memory_delete_relations.relations.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory.memory_delete_relations.relations.Input.to ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> .

