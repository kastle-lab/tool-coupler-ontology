@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.notion.notion_API-post-search.sort.Input.sort.timestamp .

tool-coupler-r:input.notion.notion_API-post-search.sort.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.notion.notion_API-post-search.sort.Input.sort.timestamp .

tool-coupler-r:metadata.notion.notion_API-post-search.sort.Input.sort.timestamp a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The name of the timestamp to sort against. Possible values include `last_edited_time`."^^xsd:string ;
    tool-coupler-ont:hasName "timestamp"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.notion.notion_API-post-search.sort.Input.sort.timestamp .

tool-coupler-r:element.notion.notion_API-post-search.sort.Input.sort.timestamp a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.notion.notion_API-post-search.sort.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-post-search.sort.Input.sort.timestamp ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

