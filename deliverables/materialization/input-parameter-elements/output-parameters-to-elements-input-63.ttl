@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.memory.memory_create_relations.relations.Input.relations.from .

tool-coupler-r:input.memory.memory_create_relations.relations.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.memory.memory_create_relations.relations.Input.relations.from .

tool-coupler-r:metadata.memory.memory_create_relations.relations.Input.relations.from a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The name of the entity where the relation starts"^^xsd:string ;
    tool-coupler-ont:hasName "from"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.memory.memory_create_relations.relations.Input.relations.from .

tool-coupler-r:element.memory.memory_create_relations.relations.Input.relations.from a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.memory.memory_create_relations.relations.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory.memory_create_relations.relations.Input.relations.from ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

