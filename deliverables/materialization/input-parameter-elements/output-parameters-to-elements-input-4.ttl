@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.airtable.airtable_create_table.fields.Input.fields.description .

tool-coupler-r:input.airtable.airtable_create_table.fields.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.airtable.airtable_create_table.fields.Input.fields.description .

tool-coupler-r:metadata.airtable.airtable_create_table.fields.Input.fields.description a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Description of the field"^^xsd:string ;
    tool-coupler-ont:hasName "description"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.airtable.airtable_create_table.fields.Input.fields.description .

tool-coupler-r:element.airtable.airtable_create_table.fields.Input.fields.description a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.airtable.airtable_create_table.fields.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable.airtable_create_table.fields.Input.fields.description ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

