@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Array a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.filter.ids .

tool-coupler-r:input.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.filter.ids .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.filter.ids a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Return only studies with the specified NCT IDs."^^xsd:string ;
    tool-coupler-ont:hasName "ids"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.filter.ids .

tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.filter.ids a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.filter.ids ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Array .

