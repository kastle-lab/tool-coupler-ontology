@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.memory.memory_delete_relations.relations.Input.relations.relationType .

tool-coupler-r:input.memory.memory_delete_relations.relations.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.memory.memory_delete_relations.relations.Input.relations.relationType .

tool-coupler-r:metadata.memory.memory_delete_relations.relations.Input.relations.relationType a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The type of the relation"^^xsd:string ;
    tool-coupler-ont:hasName "relationType"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.memory.memory_delete_relations.relations.Input.relations.relationType .

tool-coupler-r:element.memory.memory_delete_relations.relations.Input.relations.relationType a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.memory.memory_delete_relations.relations.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory.memory_delete_relations.relations.Input.relations.relationType ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

