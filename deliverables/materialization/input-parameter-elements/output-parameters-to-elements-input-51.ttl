@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.github.github_push_files.files.Input.files.path .

tool-coupler-r:input.github.github_push_files.files.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.github.github_push_files.files.Input.files.path .

tool-coupler-r:metadata.github.github_push_files.files.Input.files.path a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "path"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.github.github_push_files.files.Input.files.path .

tool-coupler-r:element.github.github_push_files.files.Input.files.path a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.github.github_push_files.files.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_push_files.files.Input.files.path ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

