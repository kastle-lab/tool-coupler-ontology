@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Boolean a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.text.translatable .

tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.text.translatable .

tool-coupler-r:metadata.lara-translate.lara-translate_translate.text.Input.text.translatable a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "translatable"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.text.translatable .

tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.text.translatable a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_translate.text.Input.text.translatable ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Boolean .

