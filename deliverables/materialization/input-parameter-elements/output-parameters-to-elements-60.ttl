@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.translatable .

tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.translatable .

tool-coupler-r:metadata.lara-translate.lara-translate_translate.text.Input.translatable a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "translatable"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.translatable .

tool-coupler-r:element.lara-translate.lara-translate_translate.text.Input.translatable a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_translate.text.Input.translatable ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean....> .

