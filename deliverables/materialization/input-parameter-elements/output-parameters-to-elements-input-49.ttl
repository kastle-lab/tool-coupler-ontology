@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.filesystem.filesystem_edit_file.edits.Input.edits.oldText .

tool-coupler-r:input.filesystem.filesystem_edit_file.edits.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.filesystem.filesystem_edit_file.edits.Input.edits.oldText .

tool-coupler-r:metadata.filesystem.filesystem_edit_file.edits.Input.edits.oldText a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Text to search for - must match exactly"^^xsd:string ;
    tool-coupler-ont:hasName "oldText"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.filesystem.filesystem_edit_file.edits.Input.edits.oldText .

tool-coupler-r:element.filesystem.filesystem_edit_file.edits.Input.edits.oldText a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.filesystem.filesystem_edit_file.edits.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem.filesystem_edit_file.edits.Input.edits.oldText ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

