@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.notion.notion_API-patch-page.cover.Input.cover.external .

tool-coupler-r:input.notion.notion_API-patch-page.cover.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.notion.notion_API-patch-page.cover.Input.cover.external .

tool-coupler-r:metadata.notion.notion_API-patch-page.cover.Input.cover.external a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "external"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.notion.notion_API-patch-page.cover.Input.cover.external .

tool-coupler-r:element.notion.notion_API-patch-page.cover.Input.cover.external a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.notion.notion_API-patch-page.cover.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-patch-page.cover.Input.cover.external ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Object .

