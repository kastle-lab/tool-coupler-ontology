@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array..> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input.networks .

tool-coupler-r:input.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input.networks .

tool-coupler-r:metadata.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input.networks a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The blockchain networks to query. e.g. [\"eth-mainnet\", \"base-mainnet\"]"^^xsd:string ;
    tool-coupler-ont:hasName "networks"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input.networks .

tool-coupler-r:element.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input.networks a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:input.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input.networks ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array..> .

