@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_create_pull_request_review_comment.path.Input .

tool-coupler-r:metadata.github.github_create_pull_request_review_comment.path.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Relative path to the file being commented on"^^xsd:string ;
    tool-coupler-ont:hasName "path"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_create_pull_request_review_comment.path.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.github.github_create_pull_request_review_comment.path.Input .

tool-coupler-r:tool.github.github_create_pull_request_review_comment a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_create_pull_request_review_comment.path.Input .

tool-coupler-r:input.github.github_create_pull_request_review_comment.path.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_create_pull_request_review_comment.path.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_create_pull_request_review_comment .

