@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.weather.weather_get_current_weather.location.Input .

tool-coupler-r:metadata.weather.weather_get_current_weather.location.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "US location as coordinates (lat,lng) in decimal degrees. Example: '40.7128,-74.0060' for New York City. Must be within US boundaries including states, territories (PR, VI, AS, GU, MP), and coastal waters."^^xsd:string ;
    tool-coupler-ont:hasName "location"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.weather.weather_get_current_weather.location.Input .

tool-coupler-r:tool.weather.weather_get_current_weather a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.weather.weather_get_current_weather.location.Input .

tool-coupler-r:input.weather.weather_get_current_weather.location.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather.weather_get_current_weather.location.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.weather.weather_get_current_weather .

