tool-coupler-r:dataType.Array a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input .

tool-coupler-r:metadata.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input a tool-coupler-ont:Metadata ;
