tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.alchemy.alchemy_fetchNftContractDataByMultichainAddress.addresses.Input .

tool-coupler-r:tool.alchemy.alchemy_fetchNftContractDataByMultichainAddress a tool-coupler-ont:Tool ;
