@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.context7.context7_get-library-docs.context7CompatibleLibraryID.Input .

tool-coupler-r:metadata.context7.context7_get-library-docs.context7CompatibleLibraryID.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Exact Context7-compatible library ID (e.g., '/mongodb/docs', '/vercel/next.js', '/supabase/supabase', '/vercel/next.js/v14.3.0-canary.87') retrieved from 'resolve-library-id' or directly from user query in the format '/org/project' or '/org/project/version'."^^xsd:string ;
    tool-coupler-ont:hasName "context7CompatibleLibraryID"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.context7.context7_get-library-docs.context7CompatibleLibraryID.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.context7.context7_get-library-docs.context7CompatibleLibraryID.Input .

tool-coupler-r:tool.context7.context7_get-library-docs a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.context7.context7_get-library-docs.context7CompatibleLibraryID.Input .

tool-coupler-r:input.context7.context7_get-library-docs.context7CompatibleLibraryID.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.context7.context7_get-library-docs.context7CompatibleLibraryID.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.context7.context7_get-library-docs .

