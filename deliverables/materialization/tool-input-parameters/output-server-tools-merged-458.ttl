@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.lara-translate.lara-translate_delete_translation.id.Input .

tool-coupler-r:metadata.lara-translate.lara-translate_delete_translation.id.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The ID or list of IDs where to delete the translation unit from. Format: mem_xyz123"^^xsd:string ;
    tool-coupler-ont:hasName "id"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.lara-translate.lara-translate_delete_translation.id.Input .

tool-coupler-r:tool.lara-translate.lara-translate_delete_translation a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.lara-translate.lara-translate_delete_translation.id.Input .

tool-coupler-r:input.lara-translate.lara-translate_delete_translation.id.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_delete_translation.id.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_delete_translation .

