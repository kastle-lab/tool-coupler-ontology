@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_im_or_mpim.Input .

tool-coupler-r:metadata.slack.slack_conversations_search_messages.filter_in_im_or_mpim.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter messages in a direct message (DM) or multi-person direct message (MPIM) conversation by its ID or name. Example: 'D1234567890' or '@username_dm'. If not provided, all DMs and MPIMs will be searched."^^xsd:string ;
    tool-coupler-ont:hasName "filter_in_im_or_mpim"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_im_or_mpim.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_im_or_mpim.Input .

tool-coupler-r:tool.slack.slack_conversations_search_messages a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_im_or_mpim.Input .

tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_im_or_mpim.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_conversations_search_messages.filter_in_im_or_mpim.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_search_messages .

