@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Number a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.alchemy.alchemy_fetchAddressTransactionHistory.limit.Input .

tool-coupler-r:metadata.alchemy.alchemy_fetchAddressTransactionHistory.limit.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The number of results to return. Default is 25. Max is 100"^^xsd:string ;
    tool-coupler-ont:hasName "limit"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.alchemy.alchemy_fetchAddressTransactionHistory.limit.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.alchemy.alchemy_fetchAddressTransactionHistory.limit.Input .

tool-coupler-r:tool.alchemy.alchemy_fetchAddressTransactionHistory a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.alchemy.alchemy_fetchAddressTransactionHistory.limit.Input .

tool-coupler-r:input.alchemy.alchemy_fetchAddressTransactionHistory.limit.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.alchemy.alchemy_fetchAddressTransactionHistory.limit.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Number ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.alchemy.alchemy_fetchAddressTransactionHistory .

