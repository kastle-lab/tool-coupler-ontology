@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.lara-translate.lara-translate_import_tmx.gzip.Input .

tool-coupler-r:metadata.lara-translate.lara-translate_import_tmx.gzip.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Indicates if the file is a compressed .gz file"^^xsd:string ;
    tool-coupler-ont:hasName "gzip"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.lara-translate.lara-translate_import_tmx.gzip.Input .

tool-coupler-r:tool.lara-translate.lara-translate_import_tmx a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.lara-translate.lara-translate_import_tmx.gzip.Input .

tool-coupler-r:input.lara-translate.lara-translate_import_tmx.gzip.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_import_tmx.gzip.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_import_tmx .

