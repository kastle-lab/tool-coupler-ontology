@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.filesystem.filesystem_search_files.excludePatterns.Input .

tool-coupler-r:metadata.filesystem.filesystem_search_files.excludePatterns.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "excludePatterns"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.filesystem.filesystem_search_files.excludePatterns.Input .

tool-coupler-r:tool.filesystem.filesystem_search_files a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.filesystem.filesystem_search_files.excludePatterns.Input .

tool-coupler-r:input.filesystem.filesystem_search_files.excludePatterns.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem.filesystem_search_files.excludePatterns.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.filesystem.filesystem_search_files .

