@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Number a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.google-workspace.google-workspace_list_events.maxResults.Input .

tool-coupler-r:metadata.google-workspace.google-workspace_list_events.maxResults.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Maximum number of events to return (default: 10)"^^xsd:string ;
    tool-coupler-ont:hasName "maxResults"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.google-workspace.google-workspace_list_events.maxResults.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.google-workspace.google-workspace_list_events.maxResults.Input .

tool-coupler-r:tool.google-workspace.google-workspace_list_events a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.google-workspace.google-workspace_list_events.maxResults.Input .

tool-coupler-r:input.google-workspace.google-workspace_list_events.maxResults.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.google-workspace.google-workspace_list_events.maxResults.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Number ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.google-workspace.google-workspace_list_events .

