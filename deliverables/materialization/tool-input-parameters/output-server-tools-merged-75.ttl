<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.arxiv.arxiv_search_papers.date_from.Input .

tool-coupler-r:metadata.arxiv.arxiv_search_papers.date_from.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "date_from"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.arxiv.arxiv_search_papers.date_from.Input .

tool-coupler-r:tool.arxiv.arxiv_search_papers a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.arxiv.arxiv_search_papers.date_from.Input .

tool-coupler-r:input.arxiv.arxiv_search_papers.date_from.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.arxiv.arxiv_search_papers.date_from.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.arxiv.arxiv_search_papers .

