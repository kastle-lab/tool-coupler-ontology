@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.mongodb.mongodb_aggregate.pipeline.Input .

tool-coupler-r:metadata.mongodb.mongodb_aggregate.pipeline.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "An array of aggregation stages to execute"^^xsd:string ;
    tool-coupler-ont:hasName "pipeline"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.mongodb.mongodb_aggregate.pipeline.Input .

tool-coupler-r:tool.mongodb.mongodb_aggregate a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.mongodb.mongodb_aggregate.pipeline.Input .

tool-coupler-r:input.mongodb.mongodb_aggregate.pipeline.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mongodb.mongodb_aggregate.pipeline.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_aggregate .

