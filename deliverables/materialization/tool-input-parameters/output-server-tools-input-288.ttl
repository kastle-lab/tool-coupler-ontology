tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_get_pull_request_review_comments.sort.Input .

tool-coupler-r:metadata.github.github_get_pull_request_review_comments.sort.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Sort comments by created or updated time"^^xsd:string ;
    tool-coupler-ont:hasName "sort"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_get_pull_request_review_comments.sort.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.github.github_get_pull_request_review_comments.sort.Input .

tool-coupler-r:tool.github.github_get_pull_request_review_comments a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_get_pull_request_review_comments.sort.Input .

tool-coupler-r:input.github.github_get_pull_request_review_comments.sort.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_get_pull_request_review_comments.sort.Input ;
