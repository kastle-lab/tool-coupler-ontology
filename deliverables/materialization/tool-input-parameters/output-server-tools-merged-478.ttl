@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input .

tool-coupler-r:metadata.lara-translate.lara-translate_translate.text.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "An array of text blocks to translate. Each block contains a text string and a boolean indicating whether it should be translated. This allows for selective translation where some text blocks can be preserved in their original form while others are translated."^^xsd:string ;
    tool-coupler-ont:hasName "text"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input .

tool-coupler-r:tool.lara-translate.lara-translate_translate a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input .

tool-coupler-r:input.lara-translate.lara-translate_translate.text.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_translate.text.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_translate .

