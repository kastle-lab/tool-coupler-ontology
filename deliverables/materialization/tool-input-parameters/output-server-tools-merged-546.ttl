@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.mongodb.mongodb_find.projection.Input .

tool-coupler-r:metadata.mongodb.mongodb_find.projection.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The projection, matching the syntax of the projection argument of db.collection.find()"^^xsd:string ;
    tool-coupler-ont:hasName "projection"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.mongodb.mongodb_find.projection.Input .

tool-coupler-r:tool.mongodb.mongodb_find a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.mongodb.mongodb_find.projection.Input .

tool-coupler-r:input.mongodb.mongodb_find.projection.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mongodb.mongodb_find.projection.Input ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_find .

