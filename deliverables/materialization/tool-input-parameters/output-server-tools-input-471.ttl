@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Array a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.memory.memory_create_entities.entities.Input .

tool-coupler-r:metadata.memory.memory_create_entities.entities.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "entities"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.memory.memory_create_entities.entities.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.memory.memory_create_entities.entities.Input .

tool-coupler-r:tool.memory.memory_create_entities a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.memory.memory_create_entities.entities.Input .

tool-coupler-r:input.memory.memory_create_entities.entities.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory.memory_create_entities.entities.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Array ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.memory.memory_create_entities .

