@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_search_users.q.Input .

tool-coupler-r:metadata.github.github_search_users.q.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search query using GitHub users search syntax. Examples: 'location:\"San Francisco\" followers:>100', 'language:python repos:>50', 'fullname:\"John Doe\"', 'type:user', 'type:org', 'created:>2020-01-01', 'in:email example.com'"^^xsd:string ;
    tool-coupler-ont:hasName "q"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_search_users.q.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.github.github_search_users.q.Input .

tool-coupler-r:tool.github.github_search_users a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_search_users.q.Input .

tool-coupler-r:input.github.github_search_users.q.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_search_users.q.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_search_users .

