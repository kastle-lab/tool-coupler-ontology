@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.osm-mcp-server.osm-mcp-server_search_category.category.Input .

tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_search_category.category.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "category"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.osm-mcp-server.osm-mcp-server_search_category.category.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.osm-mcp-server.osm-mcp-server_search_category.category.Input .

tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_search_category a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.osm-mcp-server.osm-mcp-server_search_category.category.Input .

tool-coupler-r:input.osm-mcp-server.osm-mcp-server_search_category.category.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_search_category.category.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_search_category .

