@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.open-library.open-library_get_author_info.author_key.Input .

tool-coupler-r:metadata.open-library.open-library_get_author_info.author_key.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The Open Library key for the author (e.g., OL23919A)."^^xsd:string ;
    tool-coupler-ont:hasName "author_key"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.open-library.open-library_get_author_info.author_key.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.open-library.open-library_get_author_info.author_key.Input .

tool-coupler-r:tool.open-library.open-library_get_author_info a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.open-library.open-library_get_author_info.author_key.Input .

tool-coupler-r:input.open-library.open-library_get_author_info.author_key.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.open-library.open-library_get_author_info.author_key.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.open-library.open-library_get_author_info .

