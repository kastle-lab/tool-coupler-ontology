tool-coupler-r:input.met-museum.met-museum_search-museum-objects.hasImages.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.met-museum.met-museum_search-museum-objects.hasImages.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.met-museum.met-museum_search-museum-objects .

