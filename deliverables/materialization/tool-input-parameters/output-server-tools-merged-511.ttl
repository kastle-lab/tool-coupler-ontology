<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.met-museum.met-museum_search-museum-objects.hasImages.Input .

tool-coupler-r:metadata.met-museum.met-museum_search-museum-objects.hasImages.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Only returns objects that have images"^^xsd:string ;
