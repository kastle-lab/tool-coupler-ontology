tool-coupler-r:dataType.Boolean a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_update_pull_request.maintainer_can_modify.Input .

tool-coupler-r:metadata.github.github_update_pull_request.maintainer_can_modify.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Allow maintainer edits"^^xsd:string ;
    tool-coupler-ont:hasName "maintainer_can_modify"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_update_pull_request.maintainer_can_modify.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.github.github_update_pull_request.maintainer_can_modify.Input .

tool-coupler-r:tool.github.github_update_pull_request a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_update_pull_request.maintainer_can_modify.Input .

tool-coupler-r:input.github.github_update_pull_request.maintainer_can_modify.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
