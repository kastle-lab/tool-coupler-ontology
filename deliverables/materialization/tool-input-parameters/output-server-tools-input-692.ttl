@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.oxylabs.oxylabs_amazon_search_scraper.user_agent_type.Input .

tool-coupler-r:metadata.oxylabs.oxylabs_amazon_search_scraper.user_agent_type.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Device type and browser that will be used to determine User-Agent header value."^^xsd:string ;
    tool-coupler-ont:hasName "user_agent_type"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.oxylabs.oxylabs_amazon_search_scraper.user_agent_type.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.oxylabs.oxylabs_amazon_search_scraper.user_agent_type.Input .

tool-coupler-r:tool.oxylabs.oxylabs_amazon_search_scraper a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.oxylabs.oxylabs_amazon_search_scraper.user_agent_type.Input .

tool-coupler-r:input.oxylabs.oxylabs_amazon_search_scraper.user_agent_type.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.oxylabs.oxylabs_amazon_search_scraper.user_agent_type.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.oxylabs.oxylabs_amazon_search_scraper .

