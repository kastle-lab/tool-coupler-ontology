@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.notion.notion_API-patch-block-children.children.Input .

tool-coupler-r:metadata.notion.notion_API-patch-block-children.children.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Child content to append to a container block as an array of [block objects](ref:block)"^^xsd:string ;
    tool-coupler-ont:hasName "children"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.notion.notion_API-patch-block-children.children.Input .

tool-coupler-r:tool.notion.notion_API-patch-block-children a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.notion.notion_API-patch-block-children.children.Input .

tool-coupler-r:input.notion.notion_API-patch-block-children.children.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-patch-block-children.children.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-patch-block-children .

