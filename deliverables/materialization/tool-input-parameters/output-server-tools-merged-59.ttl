@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.alchemy.alchemy_fetchTransfers.contractAddresses.Input .

tool-coupler-r:metadata.alchemy.alchemy_fetchTransfers.contractAddresses.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The contract addresses to query. e.g. [\"0x1234567890123456789012345678901234567890\"]"^^xsd:string ;
    tool-coupler-ont:hasName "contractAddresses"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.alchemy.alchemy_fetchTransfers.contractAddresses.Input .

tool-coupler-r:tool.alchemy.alchemy_fetchTransfers a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.alchemy.alchemy_fetchTransfers.contractAddresses.Input .

tool-coupler-r:input.alchemy.alchemy_fetchTransfers.contractAddresses.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.alchemy.alchemy_fetchTransfers.contractAddresses.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Array...> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.alchemy.alchemy_fetchTransfers .

