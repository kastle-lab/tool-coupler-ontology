@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.airtable.airtable_create_table.description.Input .

tool-coupler-r:metadata.airtable.airtable_create_table.description.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Description of the table"^^xsd:string ;
    tool-coupler-ont:hasName "description"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.airtable.airtable_create_table.description.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.airtable.airtable_create_table.description.Input .

tool-coupler-r:tool.airtable.airtable_create_table a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.airtable.airtable_create_table.description.Input .

tool-coupler-r:input.airtable.airtable_create_table.description.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable.airtable_create_table.description.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.airtable.airtable_create_table .

