@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.git.git_git_branch.branch_type.Input .

tool-coupler-r:metadata.git.git_git_branch.branch_type.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Whether to list local branches ('local'), remote branches ('remote') or all branches('all')."^^xsd:string ;
    tool-coupler-ont:hasName "branch_type"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.git.git_git_branch.branch_type.Input .

tool-coupler-r:tool.git.git_git_branch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.git.git_git_branch.branch_type.Input .

tool-coupler-r:input.git.git_git_branch.branch_type.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.git.git_git_branch.branch_type.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.git.git_git_branch .

