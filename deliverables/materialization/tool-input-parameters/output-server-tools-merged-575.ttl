@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.national-parks.national-parks_getCampgrounds.parkCode.Input .

tool-coupler-r:metadata.national-parks.national-parks_getCampgrounds.parkCode.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter campgrounds by park code (e.g., \"yose\" for Yosemite). Multiple parks can be comma-separated (e.g., \"yose,grca\")."^^xsd:string ;
    tool-coupler-ont:hasName "parkCode"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.national-parks.national-parks_getCampgrounds.parkCode.Input .

tool-coupler-r:tool.national-parks.national-parks_getCampgrounds a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.national-parks.national-parks_getCampgrounds.parkCode.Input .

tool-coupler-r:input.national-parks.national-parks_getCampgrounds.parkCode.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.national-parks.national-parks_getCampgrounds.parkCode.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.national-parks.national-parks_getCampgrounds .

