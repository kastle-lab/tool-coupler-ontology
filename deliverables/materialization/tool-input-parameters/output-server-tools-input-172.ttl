@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Number a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.filesystem.filesystem_read_text_file.tail.Input .

tool-coupler-r:metadata.filesystem.filesystem_read_text_file.tail.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "If provided, returns only the last N lines of the file"^^xsd:string ;
    tool-coupler-ont:hasName "tail"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.filesystem.filesystem_read_text_file.tail.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.filesystem.filesystem_read_text_file.tail.Input .

tool-coupler-r:tool.filesystem.filesystem_read_text_file a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.filesystem.filesystem_read_text_file.tail.Input .

tool-coupler-r:input.filesystem.filesystem_read_text_file.tail.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem.filesystem_read_text_file.tail.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Number ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.filesystem.filesystem_read_text_file .

