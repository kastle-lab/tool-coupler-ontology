@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.slack.slack_conversations_replies.limit.Input .

tool-coupler-r:metadata.slack.slack_conversations_replies.limit.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Limit of messages to fetch in format of maximum ranges of time (e.g. 1d - 1 day, 30d - 30 days, 90d - 90 days which is a default limit for free tier history) or number of messages (e.g. 50). Must be empty when 'cursor' is provided."^^xsd:string ;
    tool-coupler-ont:hasName "limit"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.slack.slack_conversations_replies.limit.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.slack.slack_conversations_replies.limit.Input .

tool-coupler-r:tool.slack.slack_conversations_replies a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.slack.slack_conversations_replies.limit.Input .

tool-coupler-r:input.slack.slack_conversations_replies.limit.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_conversations_replies.limit.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_replies .

