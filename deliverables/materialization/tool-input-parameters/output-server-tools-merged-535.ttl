@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.mongodb.mongodb_delete-many.filter.Input .

tool-coupler-r:metadata.mongodb.mongodb_delete-many.filter.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The query filter, specifying the deletion criteria. Matches the syntax of the filter argument of db.collection.deleteMany()"^^xsd:string ;
    tool-coupler-ont:hasName "filter"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.mongodb.mongodb_delete-many.filter.Input .

tool-coupler-r:tool.mongodb.mongodb_delete-many a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.mongodb.mongodb_delete-many.filter.Input .

tool-coupler-r:input.mongodb.mongodb_delete-many.filter.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mongodb.mongodb_delete-many.filter.Input ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_delete-many .

