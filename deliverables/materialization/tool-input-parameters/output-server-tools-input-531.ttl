@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.mongodb.mongodb_update-many.filter.Input .

tool-coupler-r:metadata.mongodb.mongodb_update-many.filter.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The selection criteria for the update, matching the syntax of the filter argument of db.collection.updateOne()"^^xsd:string ;
    tool-coupler-ont:hasName "filter"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.mongodb.mongodb_update-many.filter.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.mongodb.mongodb_update-many.filter.Input .

tool-coupler-r:tool.mongodb.mongodb_update-many a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.mongodb.mongodb_update-many.filter.Input .

tool-coupler-r:input.mongodb.mongodb_update-many.filter.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mongodb.mongodb_update-many.filter.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Object ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_update-many .

