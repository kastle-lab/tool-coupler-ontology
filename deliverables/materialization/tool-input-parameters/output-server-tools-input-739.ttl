@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_date_after.Input .

tool-coupler-r:metadata.slack.slack_conversations_search_messages.filter_date_after.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter messages sent after a specific date in format 'YYYY-MM-DD'. Example: '2023-10-01', 'July', 'Yesterday' or 'Today'. If not provided, all dates will be searched."^^xsd:string ;
    tool-coupler-ont:hasName "filter_date_after"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_date_after.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_date_after.Input .

tool-coupler-r:tool.slack.slack_conversations_search_messages a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.slack.slack_conversations_search_messages.filter_date_after.Input .

tool-coupler-r:input.slack.slack_conversations_search_messages.filter_date_after.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_conversations_search_messages.filter_date_after.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_search_messages .

