@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.national-parks.national-parks_getAlerts.parkCode.Input .

tool-coupler-r:metadata.national-parks.national-parks_getAlerts.parkCode.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter alerts by park code (e.g., \"yose\" for Yosemite). Multiple parks can be comma-separated (e.g., \"yose,grca\")."^^xsd:string ;
    tool-coupler-ont:hasName "parkCode"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.national-parks.national-parks_getAlerts.parkCode.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.national-parks.national-parks_getAlerts.parkCode.Input .

tool-coupler-r:tool.national-parks.national-parks_getAlerts a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.national-parks.national-parks_getAlerts.parkCode.Input .

tool-coupler-r:input.national-parks.national-parks_getAlerts.parkCode.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.national-parks.national-parks_getAlerts.parkCode.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.national-parks.national-parks_getAlerts .

