@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.exa.exa_web_search_exa.numResults.Input .

tool-coupler-r:metadata.exa.exa_web_search_exa.numResults.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Number of search results to return (default: 5)"^^xsd:string ;
    tool-coupler-ont:hasName "numResults"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.exa.exa_web_search_exa.numResults.Input .

tool-coupler-r:tool.exa.exa_web_search_exa a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.exa.exa_web_search_exa.numResults.Input .

tool-coupler-r:input.exa.exa_web_search_exa.numResults.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.exa.exa_web_search_exa.numResults.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.exa.exa_web_search_exa .

