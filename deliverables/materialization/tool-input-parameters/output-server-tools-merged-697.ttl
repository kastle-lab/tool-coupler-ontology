<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.osm-mcp-server.osm-mcp-server_get_route_directions.mode.Input .

tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_get_route_directions.mode.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "mode"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.osm-mcp-server.osm-mcp-server_get_route_directions.mode.Input .

tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_get_route_directions a tool-coupler-ont:Tool ;
