tool-coupler-r:input.osm-mcp-server.osm-mcp-server_get_route_directions.mode.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_get_route_directions.mode.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_get_route_directions .

