@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Number a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.national-parks.national-parks_findParks.limit.Input .

tool-coupler-r:metadata.national-parks.national-parks_findParks.limit.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Maximum number of parks to return (default: 10, max: 50)"^^xsd:string ;
    tool-coupler-ont:hasName "limit"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.national-parks.national-parks_findParks.limit.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.national-parks.national-parks_findParks.limit.Input .

tool-coupler-r:tool.national-parks.national-parks_findParks a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.national-parks.national-parks_findParks.limit.Input .

tool-coupler-r:input.national-parks.national-parks_findParks.limit.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.national-parks.national-parks_findParks.limit.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Number ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.national-parks.national-parks_findParks .

