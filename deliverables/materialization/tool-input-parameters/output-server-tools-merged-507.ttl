<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.met-museum.met-museum_get-museum-object.objectId.Input .

tool-coupler-r:metadata.met-museum.met-museum_get-museum-object.objectId.Input a tool-coupler-ont:Metadata ;
