@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Boolean a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.slack.slack_conversations_replies.include_activity_messages.Input .

tool-coupler-r:metadata.slack.slack_conversations_replies.include_activity_messages.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "If true, the response will include activity messages such as 'channel_join' or 'channel_leave'. Default is boolean false."^^xsd:string ;
    tool-coupler-ont:hasName "include_activity_messages"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.slack.slack_conversations_replies.include_activity_messages.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.slack.slack_conversations_replies.include_activity_messages.Input .

tool-coupler-r:tool.slack.slack_conversations_replies a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.slack.slack_conversations_replies.include_activity_messages.Input .

tool-coupler-r:input.slack.slack_conversations_replies.include_activity_messages.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_conversations_replies.include_activity_messages.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Boolean ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_replies .

