@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.desktop-commander.desktop-commander_set_config_value.value.Input .

tool-coupler-r:metadata.desktop-commander.desktop-commander_set_config_value.value.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "value"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.desktop-commander.desktop-commander_set_config_value.value.Input .

tool-coupler-r:tool.desktop-commander.desktop-commander_set_config_value a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.desktop-commander.desktop-commander_set_config_value.value.Input .

tool-coupler-r:input.desktop-commander.desktop-commander_set_config_value.value.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.desktop-commander.desktop-commander_set_config_value.value.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.desktop-commander.desktop-commander_set_config_value .

