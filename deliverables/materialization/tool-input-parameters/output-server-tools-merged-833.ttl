@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf <https://kastle-lab.github.io/tool-couplerlod/resource/input.twelvedata.twelvedata_GetEod.currency.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/metadata.twelvedata.twelvedata_GetEod.currency.> a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Currency in which instrument is denominated"^^xsd:string ;
    tool-coupler-ont:hasName "currency"^^xsd:string ;
    tool-coupler-ont:metadataOf <https://kastle-lab.github.io/tool-couplerlod/resource/input.twelvedata.twelvedata_GetEod.currency.> .

tool-coupler-r:tool.twelvedata.twelvedata_GetEod a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter <https://kastle-lab.github.io/tool-couplerlod/resource/input.twelvedata.twelvedata_GetEod.currency.> .

<https://kastle-lab.github.io/tool-couplerlod/resource/input.twelvedata.twelvedata_GetEod.currency.> a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata <https://kastle-lab.github.io/tool-couplerlod/resource/metadata.twelvedata.twelvedata_GetEod.currency.> ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.twelvedata.twelvedata_GetEod .

