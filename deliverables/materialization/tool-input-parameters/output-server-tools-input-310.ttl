@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Number a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_list_issues.per_page.Input .

tool-coupler-r:metadata.github.github_list_issues.per_page.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Results per page (default 10, max 100)"^^xsd:string ;
    tool-coupler-ont:hasName "per_page"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_list_issues.per_page.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.github.github_list_issues.per_page.Input .

tool-coupler-r:tool.github.github_list_issues a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_list_issues.per_page.Input .

tool-coupler-r:input.github.github_list_issues.per_page.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_list_issues.per_page.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Number ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_list_issues .

