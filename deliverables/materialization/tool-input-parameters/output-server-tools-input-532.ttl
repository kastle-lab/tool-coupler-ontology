@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.mongodb.mongodb_update-many.update.Input .

tool-coupler-r:metadata.mongodb.mongodb_update-many.update.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "An update document describing the modifications to apply using update operator expressions"^^xsd:string ;
    tool-coupler-ont:hasName "update"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.mongodb.mongodb_update-many.update.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.mongodb.mongodb_update-many.update.Input .

tool-coupler-r:tool.mongodb.mongodb_update-many a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.mongodb.mongodb_update-many.update.Input .

tool-coupler-r:input.mongodb.mongodb_update-many.update.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mongodb.mongodb_update-many.update.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Object ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.mongodb.mongodb_update-many .

