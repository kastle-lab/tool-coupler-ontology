@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.git.git_git_branch.not_contains.Input .

tool-coupler-r:metadata.git.git_git_branch.not_contains.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The commit sha that branch should NOT contain. Do not pass anything to this param if no commit sha is specified"^^xsd:string ;
    tool-coupler-ont:hasName "not_contains"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.git.git_git_branch.not_contains.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.git.git_git_branch.not_contains.Input .

tool-coupler-r:tool.git.git_git_branch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.git.git_git_branch.not_contains.Input .

tool-coupler-r:input.git.git_git_branch.not_contains.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.git.git_git_branch.not_contains.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.git.git_git_branch .

