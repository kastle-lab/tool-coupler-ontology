@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.lara-translate.lara-translate_delete_translation.target.Input .

tool-coupler-r:metadata.lara-translate.lara-translate_delete_translation.target.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The target language code of the translation"^^xsd:string ;
    tool-coupler-ont:hasName "target"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.lara-translate.lara-translate_delete_translation.target.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.lara-translate.lara-translate_delete_translation.target.Input .

tool-coupler-r:tool.lara-translate.lara-translate_delete_translation a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.lara-translate.lara-translate_delete_translation.target.Input .

tool-coupler-r:input.lara-translate.lara-translate_delete_translation.target.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_delete_translation.target.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_delete_translation .

