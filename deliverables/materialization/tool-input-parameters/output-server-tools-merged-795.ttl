@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_channel.Input .

tool-coupler-r:metadata.slack.slack_conversations_search_messages.filter_in_channel.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter messages in a specific channel by its ID or name. Example: 'C1234567890' or '#general'. If not provided, all channels will be searched."^^xsd:string ;
    tool-coupler-ont:hasName "filter_in_channel"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_channel.Input .

tool-coupler-r:tool.slack.slack_conversations_search_messages a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_channel.Input .

tool-coupler-r:input.slack.slack_conversations_search_messages.filter_in_channel.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_conversations_search_messages.filter_in_channel.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_conversations_search_messages .

