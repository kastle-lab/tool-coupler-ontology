@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.weather.weather_get_weather_alerts.severity.Input .

tool-coupler-r:metadata.weather.weather_get_weather_alerts.severity.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter by alert severity: 'extreme' (life-threatening), 'severe' (significant threat), 'moderate' (possible threat), 'minor' (minimal threat), or 'all' (default - shows all active alerts)."^^xsd:string ;
    tool-coupler-ont:hasName "severity"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.weather.weather_get_weather_alerts.severity.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.weather.weather_get_weather_alerts.severity.Input .

tool-coupler-r:tool.weather.weather_get_weather_alerts a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.weather.weather_get_weather_alerts.severity.Input .

tool-coupler-r:input.weather.weather_get_weather_alerts.severity.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather.weather_get_weather_alerts.severity.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.weather.weather_get_weather_alerts .

