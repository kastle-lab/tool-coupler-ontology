@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.google-workspace.google-workspace_search_emails.query.Input .

tool-coupler-r:metadata.google-workspace.google-workspace_search_emails.query.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Gmail search query (e.g., "from:example@gmail.com has:attachment"). Examples:
- "from:alice@example.com" (Emails from Alice)
- "to:bob@example.com" (Emails sent to Bob)
- "subject:Meeting Update" (Emails with "Meeting Update" in the subject)
- "has:attachment filename:pdf" (Emails with PDF attachments)
- "after:2024/01/01 before:2024/02/01" (Emails between specific dates)
- "is:unread" (Unread emails)
- "from:@company.com has:attachment" (Emails from a company domain with attachments)"""^^xsd:string ;
    tool-coupler-ont:hasName "query"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.google-workspace.google-workspace_search_emails.query.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.google-workspace.google-workspace_search_emails.query.Input .

tool-coupler-r:tool.google-workspace.google-workspace_search_emails a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.google-workspace.google-workspace_search_emails.query.Input .

tool-coupler-r:input.google-workspace.google-workspace_search_emails.query.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.google-workspace.google-workspace_search_emails.query.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.google-workspace.google-workspace_search_emails .

