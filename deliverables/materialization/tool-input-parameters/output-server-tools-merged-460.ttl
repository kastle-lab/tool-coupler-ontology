@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.lara-translate.lara-translate_delete_translation.sentence_after.Input .

tool-coupler-r:metadata.lara-translate.lara-translate_delete_translation.sentence_after.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The sentence after the source sentence to specify the context of the translation unit"^^xsd:string ;
    tool-coupler-ont:hasName "sentence_after"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.lara-translate.lara-translate_delete_translation.sentence_after.Input .

tool-coupler-r:tool.lara-translate.lara-translate_delete_translation a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.lara-translate.lara-translate_delete_translation.sentence_after.Input .

tool-coupler-r:input.lara-translate.lara-translate_delete_translation.sentence_after.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_delete_translation.sentence_after.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_delete_translation .

