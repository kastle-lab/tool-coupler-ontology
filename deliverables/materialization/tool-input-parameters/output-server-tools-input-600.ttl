@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.notion.notion_API-retrieve-a-comment.start_cursor.Input .

tool-coupler-r:metadata.notion.notion_API-retrieve-a-comment.start_cursor.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "If supplied, this endpoint will return a page of results starting after the cursor provided. If not supplied, this endpoint will return the first page of results."^^xsd:string ;
    tool-coupler-ont:hasName "start_cursor"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.notion.notion_API-retrieve-a-comment.start_cursor.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.notion.notion_API-retrieve-a-comment.start_cursor.Input .

tool-coupler-r:tool.notion.notion_API-retrieve-a-comment a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.notion.notion_API-retrieve-a-comment.start_cursor.Input .

tool-coupler-r:input.notion.notion_API-retrieve-a-comment.start_cursor.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-retrieve-a-comment.start_cursor.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-retrieve-a-comment .

