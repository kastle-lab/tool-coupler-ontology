tool-coupler-r:dataType.Number a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.pageSize.Input .

tool-coupler-r:metadata.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.pageSize.Input a tool-coupler-ont:Metadata ;
