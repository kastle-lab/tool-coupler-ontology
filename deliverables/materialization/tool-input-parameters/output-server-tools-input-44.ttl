    tool-coupler-ont:hasName "pageSize"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.alchemy.alchemy_fetchNftsOwnedByMultichainAddresses.pageSize.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
