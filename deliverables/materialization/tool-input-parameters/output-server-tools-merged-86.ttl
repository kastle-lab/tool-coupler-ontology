@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.cli-mcp-server.cli-mcp-server_run_command.command.Input .

tool-coupler-r:metadata.cli-mcp-server.cli-mcp-server_run_command.command.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Single command to execute (example: 'ls -l' or 'cat file.txt')"^^xsd:string ;
    tool-coupler-ont:hasName "command"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.cli-mcp-server.cli-mcp-server_run_command.command.Input .

tool-coupler-r:tool.cli-mcp-server.cli-mcp-server_run_command a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.cli-mcp-server.cli-mcp-server_run_command.command.Input .

tool-coupler-r:input.cli-mcp-server.cli-mcp-server_run_command.command.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.cli-mcp-server.cli-mcp-server_run_command.command.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.cli-mcp-server.cli-mcp-server_run_command .

