<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.oxylabs.oxylabs_amazon_product_scraper.parse.Input .

tool-coupler-r:metadata.oxylabs.oxylabs_amazon_product_scraper.parse.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Should result be parsed. If the result is not parsed, the output_format parameter is applied."^^xsd:string ;
    tool-coupler-ont:hasName "parse"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.oxylabs.oxylabs_amazon_product_scraper.parse.Input .

tool-coupler-r:tool.oxylabs.oxylabs_amazon_product_scraper a tool-coupler-ont:Tool ;
