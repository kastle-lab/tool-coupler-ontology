@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.brave-search.brave-search_brave_local_search.query.Input .

tool-coupler-r:metadata.brave-search.brave-search_brave_local_search.query.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Local search query (e.g. 'pizza near Central Park')"^^xsd:string ;
    tool-coupler-ont:hasName "query"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.brave-search.brave-search_brave_local_search.query.Input .

tool-coupler-r:tool.brave-search.brave-search_brave_local_search a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.brave-search.brave-search_brave_local_search.query.Input .

tool-coupler-r:input.brave-search.brave-search_brave_local_search.query.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.brave-search.brave-search_brave_local_search.query.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.brave-search.brave-search_brave_local_search .

