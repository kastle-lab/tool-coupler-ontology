@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Integer a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.notion.notion_API-retrieve-a-page-property.page_size.Input .

tool-coupler-r:metadata.notion.notion_API-retrieve-a-page-property.page_size.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "For paginated properties. The max number of property item objects on a page. The default size is 100"^^xsd:string ;
    tool-coupler-ont:hasName "page_size"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.notion.notion_API-retrieve-a-page-property.page_size.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.notion.notion_API-retrieve-a-page-property.page_size.Input .

tool-coupler-r:tool.notion.notion_API-retrieve-a-page-property a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.notion.notion_API-retrieve-a-page-property.page_size.Input .

tool-coupler-r:input.notion.notion_API-retrieve-a-page-property.page_size.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-retrieve-a-page-property.page_size.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Integer ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.notion.notion_API-retrieve-a-page-property .

