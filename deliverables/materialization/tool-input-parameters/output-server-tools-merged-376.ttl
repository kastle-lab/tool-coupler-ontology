@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_search_repositories.query.Input .

tool-coupler-r:metadata.github.github_search_repositories.query.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search query. Examples: 'language:typescript stars:>1000', 'org:facebook react', 'machine learning in:description', 'user:octocat', 'created:>2023-01-01', 'license:mit', 'topic:javascript', 'is:public archived:false'"^^xsd:string ;
    tool-coupler-ont:hasName "query"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_search_repositories.query.Input .

tool-coupler-r:tool.github.github_search_repositories a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_search_repositories.query.Input .

tool-coupler-r:input.github.github_search_repositories.query.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_search_repositories.query.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired true ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_search_repositories .

