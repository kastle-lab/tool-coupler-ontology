@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.slack.slack_channels_list.cursor.Input .

tool-coupler-r:metadata.slack.slack_channels_list.cursor.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Cursor for pagination. Use the value of the last row and column in the response as next_cursor field returned from the previous request."^^xsd:string ;
    tool-coupler-ont:hasName "cursor"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.slack.slack_channels_list.cursor.Input .

tool-coupler-r:tool.slack.slack_channels_list a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.slack.slack_channels_list.cursor.Input .

tool-coupler-r:input.slack.slack_channels_list.cursor.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_channels_list.cursor.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.slack.slack_channels_list .

