@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Integer a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.ddg-search.ddg-search_search.max_results.Input .

tool-coupler-r:metadata.ddg-search.ddg-search_search.max_results.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "max_results"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.ddg-search.ddg-search_search.max_results.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.ddg-search.ddg-search_search.max_results.Input .

tool-coupler-r:tool.ddg-search.ddg-search_search a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.ddg-search.ddg-search_search.max_results.Input .

tool-coupler-r:input.ddg-search.ddg-search_search.max_results.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.ddg-search.ddg-search_search.max_results.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Integer ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.ddg-search.ddg-search_search .

