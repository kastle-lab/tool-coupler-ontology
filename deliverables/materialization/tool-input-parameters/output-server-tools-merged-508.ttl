<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.met-museum.met-museum_get-museum-object.returnImage.Input .

tool-coupler-r:metadata.met-museum.met-museum_get-museum-object.returnImage.Input a tool-coupler-ont:Metadata ;
