@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.lara-translate.lara-translate_create_memory.external_id.Input .

tool-coupler-r:metadata.lara-translate.lara-translate_create_memory.external_id.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The ID of the memory to be imported from MyMemory. Use this to initialize the memory with external content. Format: ext_my_[MyMemory ID]"^^xsd:string ;
    tool-coupler-ont:hasName "external_id"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.lara-translate.lara-translate_create_memory.external_id.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.lara-translate.lara-translate_create_memory.external_id.Input .

tool-coupler-r:tool.lara-translate.lara-translate_create_memory a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.lara-translate.lara-translate_create_memory.external_id.Input .

tool-coupler-r:input.lara-translate.lara-translate_create_memory.external_id.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_create_memory.external_id.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.lara-translate.lara-translate_create_memory .

