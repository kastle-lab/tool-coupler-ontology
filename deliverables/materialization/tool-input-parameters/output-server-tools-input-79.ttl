@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Number a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.brave-search.brave-search_brave_web_search.count.Input .

tool-coupler-r:metadata.brave-search.brave-search_brave_web_search.count.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Number of results (1-20, default 10)"^^xsd:string ;
    tool-coupler-ont:hasName "count"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.brave-search.brave-search_brave_web_search.count.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.brave-search.brave-search_brave_web_search.count.Input .

tool-coupler-r:tool.brave-search.brave-search_brave_web_search a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.brave-search.brave-search_brave_web_search.count.Input .

tool-coupler-r:input.brave-search.brave-search_brave_web_search.count.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.brave-search.brave-search_brave_web_search.count.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Number ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.brave-search.brave-search_brave_web_search .

