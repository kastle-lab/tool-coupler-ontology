@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.oxylabs.oxylabs_universal_scraper.render.Input .

tool-coupler-r:metadata.oxylabs.oxylabs_universal_scraper.render.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Whether a headless browser should be used to render the page.
        For example:
            - 'html' when browser is required to render the page."""^^xsd:string ;
    tool-coupler-ont:hasName "render"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.oxylabs.oxylabs_universal_scraper.render.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.oxylabs.oxylabs_universal_scraper.render.Input .

tool-coupler-r:tool.oxylabs.oxylabs_universal_scraper a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.oxylabs.oxylabs_universal_scraper.render.Input .

tool-coupler-r:input.oxylabs.oxylabs_universal_scraper.render.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.oxylabs.oxylabs_universal_scraper.render.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.oxylabs.oxylabs_universal_scraper .

