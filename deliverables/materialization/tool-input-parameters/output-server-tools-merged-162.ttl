@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean....Integer..> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.fetch.fetch_fetch.start_index.Input .

tool-coupler-r:metadata.fetch.fetch_fetch.start_index.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "On return output starting at this character index, useful if a previous fetch was truncated and more context is required."^^xsd:string ;
    tool-coupler-ont:hasName "start_index"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.fetch.fetch_fetch.start_index.Input .

tool-coupler-r:tool.fetch.fetch_fetch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.fetch.fetch_fetch.start_index.Input .

tool-coupler-r:input.fetch.fetch_fetch.start_index.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.fetch.fetch_fetch.start_index.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean....Integer..> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.fetch.fetch_fetch .

