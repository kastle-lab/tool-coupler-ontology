@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_search_repositories.per_page.Input .

tool-coupler-r:metadata.github.github_search_repositories.per_page.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Results per page (default 10, max 100)"^^xsd:string ;
    tool-coupler-ont:hasName "per_page"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_search_repositories.per_page.Input .

tool-coupler-r:tool.github.github_search_repositories a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_search_repositories.per_page.Input .

tool-coupler-r:input.github.github_search_repositories.per_page.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_search_repositories.per_page.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.....Number.> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_search_repositories .

