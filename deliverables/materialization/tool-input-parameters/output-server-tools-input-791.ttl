@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.weather.weather_get_weather_alerts.location.Input .

tool-coupler-r:metadata.weather.weather_get_weather_alerts.location.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "US location as coordinates (lat,lng) in decimal degrees OR 2-letter state/territory code. Examples: '40.7128,-74.0060' for New York City, 'CA' for California, 'PR' for Puerto Rico. Valid state codes: AL, AK, AS, AR, AZ, CA, CO, CT, DE, DC, FL, GA, GU, HI, ID, IL, IN, IA, KS, KY, LA, ME, MD, MA, MI, MN, MS, MO, MT, NE, NV, NH, NJ, NM, NY, NC, ND, OH, OK, OR, PA, PR, RI, SC, SD, TN, TX, UT, VT, VI, VA, WA, WV, WI, WY, MP, PW, FM, MH."^^xsd:string ;
    tool-coupler-ont:hasName "location"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.weather.weather_get_weather_alerts.location.Input .

tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.weather.weather_get_weather_alerts.location.Input .

tool-coupler-r:tool.weather.weather_get_weather_alerts a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.weather.weather_get_weather_alerts.location.Input .

tool-coupler-r:input.weather.weather_get_weather_alerts.location.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather.weather_get_weather_alerts.location.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Required ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.weather.weather_get_weather_alerts .

