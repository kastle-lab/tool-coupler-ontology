@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.Integer a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.git.git_git_log.max_count.Input .

tool-coupler-r:metadata.git.git_git_log.max_count.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "max_count"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.git.git_git_log.max_count.Input .

tool-coupler-r:requirementStatus.Optional a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.git.git_git_log.max_count.Input .

tool-coupler-r:tool.git.git_git_log a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.git.git_git_log.max_count.Input .

tool-coupler-r:input.git.git_git_log.max_count.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.git.git_git_log.max_count.Input ;
    tool-coupler-ont:hasRequirementStatus tool-coupler-r:requirementStatus.Optional ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.Integer ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.git.git_git_log .

