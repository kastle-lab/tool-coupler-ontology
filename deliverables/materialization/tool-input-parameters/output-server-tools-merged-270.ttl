@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.github.github_create_repository.autoInit.Input .

tool-coupler-r:metadata.github.github_create_repository.autoInit.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Initialize with README"^^xsd:string ;
    tool-coupler-ont:hasName "autoInit"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.github.github_create_repository.autoInit.Input .

tool-coupler-r:tool.github.github_create_repository a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.github.github_create_repository.autoInit.Input .

tool-coupler-r:input.github.github_create_repository.autoInit.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_create_repository.autoInit.Input ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean.....> ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.github.github_create_repository .

