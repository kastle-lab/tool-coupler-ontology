tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.alchemy.alchemy_fetchTokenPriceHistoryBySymbol.startTime.Input .

tool-coupler-r:metadata.alchemy.alchemy_fetchTokenPriceHistoryBySymbol.startTime.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The start time date to query. e.g. \"2021-01-01\""^^xsd:string ;
    tool-coupler-ont:hasName "startTime"^^xsd:string ;
