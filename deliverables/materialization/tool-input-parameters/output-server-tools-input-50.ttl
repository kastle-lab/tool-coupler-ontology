tool-coupler-r:requirementStatus.Required a tool-coupler-ont:RequirementStatus ;
    tool-coupler-ont:requirementStatusOf tool-coupler-r:input.alchemy.alchemy_fetchTokenPriceHistoryBySymbol.startTime.Input .

tool-coupler-r:tool.alchemy.alchemy_fetchTokenPriceHistoryBySymbol a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.alchemy.alchemy_fetchTokenPriceHistoryBySymbol.startTime.Input .

tool-coupler-r:input.alchemy.alchemy_fetchTokenPriceHistoryBySymbol.startTime.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
