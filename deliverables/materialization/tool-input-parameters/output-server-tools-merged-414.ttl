@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean......Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:input.google-maps.google-maps_maps_search_places.location.Input .

tool-coupler-r:metadata.google-maps.google-maps_maps_search_places.location.Input a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Optional center point for the search"^^xsd:string ;
    tool-coupler-ont:hasName "location"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:input.google-maps.google-maps_maps_search_places.location.Input .

tool-coupler-r:tool.google-maps.google-maps_maps_search_places a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasParameter tool-coupler-r:input.google-maps.google-maps_maps_search_places.location.Input .

tool-coupler-r:input.google-maps.google-maps_maps_search_places.location.Input a tool-coupler-ont:Input,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.google-maps.google-maps_maps_search_places.location.Input ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean......Object ;
    tool-coupler-ont:isRequired false ;
    tool-coupler-ont:parameterOf tool-coupler-r:tool.google-maps.google-maps_maps_search_places .

