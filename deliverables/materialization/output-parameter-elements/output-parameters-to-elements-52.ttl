@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.filesystem.filesystem_edit_file.edits..newText .

tool-coupler-r:metadata.filesystem.filesystem_edit_file.edits..newText a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Text to replace with"^^xsd:string ;
    tool-coupler-ont:hasName "newText"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.filesystem.filesystem_edit_file.edits..newText .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_edit_file.edits.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.filesystem.filesystem_edit_file.edits..newText .

tool-coupler-r:element.filesystem.filesystem_edit_file.edits..newText a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.filesystem.filesystem_edit_file.edits.> ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem.filesystem_edit_file.edits..newText ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> .

