@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean.....Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter..geo .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter..geo a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Filter results to a geographic area by providing a point and radius."^^xsd:string ;
    tool-coupler-ont:hasName "geo"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter..geo .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter..geo .

tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter..geo a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.> ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter..geo ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean.....Object .

