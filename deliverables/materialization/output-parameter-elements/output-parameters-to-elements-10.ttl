@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:boolean.....Object a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.airtable.airtable_update_field.updates..options .

tool-coupler-r:metadata.airtable.airtable_update_field.updates..options a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "New field-specific options"^^xsd:string ;
    tool-coupler-ont:hasName "options"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.airtable.airtable_update_field.updates..options .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_update_field.updates.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.airtable.airtable_update_field.updates..options .

tool-coupler-r:element.airtable.airtable_update_field.updates..options a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.airtable.airtable_update_field.updates.> ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable.airtable_update_field.updates..options ;
    tool-coupler-ont:isOfDataType tool-coupler-r:boolean.....Object .

