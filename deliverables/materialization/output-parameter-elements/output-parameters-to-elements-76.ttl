@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.notion.notion_API-post-search.sort..direction .

tool-coupler-r:metadata.notion.notion_API-post-search.sort..direction a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The direction to sort. Possible values include `ascending` and `descending`."^^xsd:string ;
    tool-coupler-ont:hasName "direction"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.notion.notion_API-post-search.sort..direction .

<https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-search.sort.> a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.notion.notion_API-post-search.sort..direction .

tool-coupler-r:element.notion.notion_API-post-search.sort..direction a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf <https://kastle-lab.github.io/tool-couplerlod/resource/output.notion.notion_API-post-search.sort.> ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-post-search.sort..direction ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean..String...> .

