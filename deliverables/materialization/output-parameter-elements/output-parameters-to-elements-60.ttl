<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.Boolean....> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.lara-translate.lara-translate_translate.text..translatable .

