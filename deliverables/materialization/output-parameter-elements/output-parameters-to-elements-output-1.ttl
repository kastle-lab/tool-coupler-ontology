@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.filesystem.filesystem_read_media_file.content.Output.content.mimeType .

tool-coupler-r:metadata.filesystem.filesystem_read_media_file.content.Output.content.mimeType a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "mimeType"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.filesystem.filesystem_read_media_file.content.Output.content.mimeType .

tool-coupler-r:output.filesystem.filesystem_read_media_file.content.Output a tool-coupler-ont:Output,
        tool-coupler-ont:Parameter ;
    tool-coupler-ont:containsElement tool-coupler-r:element.filesystem.filesystem_read_media_file.content.Output.content.mimeType .

tool-coupler-r:element.filesystem.filesystem_read_media_file.content.Output.content.mimeType a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:output.filesystem.filesystem_read_media_file.content.Output ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem.filesystem_read_media_file.content.Output.content.mimeType ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

