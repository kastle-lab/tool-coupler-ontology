@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.weather a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "weather"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.weather .

tool-coupler-r:metadata.weather.weather_get_weather_alerts a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get active weather alerts, warnings, watches, and advisories for locations in the United States. Perfect for 'Are there any weather alerts in [US location]?' questions. Covers severe weather, winter storms, heat warnings, flood alerts, and more."^^xsd:string ;
    tool-coupler-ont:hasName "weather_get_weather_alerts"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.weather.weather_get_weather_alerts .

tool-coupler-r:server.weather a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.weather.weather_get_weather_alerts .

tool-coupler-r:tool.weather.weather_get_weather_alerts a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather.weather_get_weather_alerts ;
    tool-coupler-ont:toolOf tool-coupler-r:server.weather .

