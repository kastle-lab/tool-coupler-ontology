@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "clinicaltrialsgov-mcp-server"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.clinicaltrialsgov-mcp-server .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Performs a statistical analysis on a set of clinical trials, aggregating data by status, country, sponsor, or phase. Use specific query parameters to refine the analysis and filter the studies included in the analysis. The tool can handle up to 5000 studies per analysis."^^xsd:string ;
    tool-coupler-ont:hasName "clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends .

tool-coupler-r:server.clinicaltrialsgov-mcp-server a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends .

tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends ;
    tool-coupler-ont:toolOf tool-coupler-r:server.clinicaltrialsgov-mcp-server .

