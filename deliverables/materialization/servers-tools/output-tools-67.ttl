@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.filesystem a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "filesystem"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.filesystem .

tool-coupler-r:metadata.filesystem.filesystem_create_directory a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Create a new directory or ensure a directory exists. Can create multiple nested directories in one operation. If the directory already exists, this operation will succeed silently. Perfect for setting up directory structures for projects or ensuring required paths exist. Only works within allowed directories."^^xsd:string ;
    tool-coupler-ont:hasName "filesystem_create_directory"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.filesystem.filesystem_create_directory .

tool-coupler-r:server.filesystem a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.filesystem.filesystem_create_directory .

tool-coupler-r:tool.filesystem.filesystem_create_directory a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem.filesystem_create_directory ;
    tool-coupler-ont:toolOf tool-coupler-r:server.filesystem .

