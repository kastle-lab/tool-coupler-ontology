@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.met-museum a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "met-museum"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.met-museum .

tool-coupler-r:metadata.met-museum.met-museum_list-departments a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "List all departments in the Metropolitan Museum of Art (Met Museum)"^^xsd:string ;
    tool-coupler-ont:hasName "met-museum_list-departments"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.met-museum.met-museum_list-departments .

tool-coupler-r:server.met-museum a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.met-museum ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.met-museum.met-museum_list-departments .

tool-coupler-r:tool.met-museum.met-museum_list-departments a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.met-museum.met-museum_list-departments ;
    tool-coupler-ont:toolOf tool-coupler-r:server.met-museum .

