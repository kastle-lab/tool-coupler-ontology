@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.oxylabs a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "oxylabs"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.oxylabs .

tool-coupler-r:metadata.oxylabs.oxylabs_universal_scraper a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Get a content of any webpage.

Supports browser rendering, parsing of certain webpages
and different output formats."""^^xsd:string ;
    tool-coupler-ont:hasName "oxylabs_universal_scraper"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.oxylabs.oxylabs_universal_scraper .

tool-coupler-r:server.oxylabs a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.oxylabs ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.oxylabs.oxylabs_universal_scraper .

tool-coupler-r:tool.oxylabs.oxylabs_universal_scraper a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.oxylabs.oxylabs_universal_scraper ;
    tool-coupler-ont:toolOf tool-coupler-r:server.oxylabs .

