@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.calculator a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "calculator"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.calculator .

tool-coupler-r:metadata.calculator.calculator_calculate a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Calculates/evaluates the given expression."^^xsd:string ;
    tool-coupler-ont:hasName "calculator_calculate"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.calculator.calculator_calculate .

tool-coupler-r:server.calculator a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.calculator ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.calculator.calculator_calculate .

tool-coupler-r:tool.calculator.calculator_calculate a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.calculator.calculator_calculate ;
    tool-coupler-ont:toolOf tool-coupler-r:server.calculator .

