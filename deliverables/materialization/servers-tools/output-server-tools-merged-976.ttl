@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.weather-data a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "weather-data"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.weather-data .

tool-coupler-r:metadata.weather-data.weather-data_weather_forecast a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Get weather forecast (1–14 days) for a location.
Args:
    q (str): Location query (city name, lat/lon, postal code, etc).
    days (int): Number of days (1–14).
    aqi (str): Include air quality ('yes' or 'no').
    alerts (str): Include weather alerts ('yes' or 'no').
Returns:
    dict: WeatherAPI forecast JSON."""^^xsd:string ;
    tool-coupler-ont:hasName "weather-data_weather_forecast"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.weather-data.weather-data_weather_forecast .

tool-coupler-r:server.weather-data a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather-data ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.weather-data.weather-data_weather_forecast .

tool-coupler-r:tool.weather-data.weather-data_weather_forecast a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather-data.weather-data_weather_forecast ;
    tool-coupler-ont:toolOf tool-coupler-r:server.weather-data .

