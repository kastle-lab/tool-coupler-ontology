@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.desktop-commander a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "desktop-commander"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.desktop-commander .

tool-coupler-r:metadata.desktop-commander.desktop-commander_search_files a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Finds files by name using a case-insensitive substring matching.
                        
                        Use this instead of 'execute_command' with find/dir/ls for locating files.
                        Searches through all subdirectories from the starting path.
                        
                        Has a default timeout of 30 seconds which can be customized using the timeoutMs parameter.
                        Only searches within allowed directories.
                        
                        IMPORTANT: Always use absolute paths for reliability. Paths are automatically normalized regardless of slash direction. Relative paths may fail as they depend on the current working directory. Tilde paths (~/...) might not work in all contexts. Unless the user explicitly asks for relative paths, use absolute paths.
                        This command can be referenced as "DC: ..." or "use Desktop Commander to ..." in your instructions."""^^xsd:string ;
    tool-coupler-ont:hasName "desktop-commander_search_files"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.desktop-commander.desktop-commander_search_files .

tool-coupler-r:server.desktop-commander a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.desktop-commander ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.desktop-commander.desktop-commander_search_files .

tool-coupler-r:tool.desktop-commander.desktop-commander_search_files a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.desktop-commander.desktop-commander_search_files ;
    tool-coupler-ont:toolOf tool-coupler-r:server.desktop-commander .

