@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.wikipedia a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "wikipedia"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.wikipedia .

tool-coupler-r:metadata.wikipedia.wikipedia_extract_key_facts a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Extract key facts from a Wikipedia article, optionally focused on a topic."^^xsd:string ;
    tool-coupler-ont:hasName "wikipedia_extract_key_facts"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.wikipedia.wikipedia_extract_key_facts .

tool-coupler-r:server.wikipedia a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.wikipedia ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.wikipedia.wikipedia_extract_key_facts .

tool-coupler-r:tool.wikipedia.wikipedia_extract_key_facts a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.wikipedia.wikipedia_extract_key_facts ;
    tool-coupler-ont:toolOf tool-coupler-r:server.wikipedia .

