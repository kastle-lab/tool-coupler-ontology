@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.google-maps a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "google-maps"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.google-maps .

tool-coupler-r:metadata.google-maps.google-maps_maps_distance_matrix a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Calculate travel distance and time for multiple origins and destinations"^^xsd:string ;
    tool-coupler-ont:hasName "google-maps_maps_distance_matrix"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.google-maps.google-maps_maps_distance_matrix .

tool-coupler-r:server.google-maps a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.google-maps ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.google-maps.google-maps_maps_distance_matrix .

tool-coupler-r:tool.google-maps.google-maps_maps_distance_matrix a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.google-maps.google-maps_maps_distance_matrix ;
    tool-coupler-ont:toolOf tool-coupler-r:server.google-maps .

