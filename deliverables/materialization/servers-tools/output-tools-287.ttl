@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.weather-data a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "weather-data"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.weather-data .

tool-coupler-r:metadata.weather-data.weather-data_weather_history a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Get historical weather for a location on a given date (YYYY-MM-DD).
Args:
    q (str): Location query.
    dt (str): Date in YYYY-MM-DD format.
Returns:
    dict: WeatherAPI history JSON."""^^xsd:string ;
    tool-coupler-ont:hasName "weather-data_weather_history"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.weather-data.weather-data_weather_history .

tool-coupler-r:server.weather-data a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather-data ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.weather-data.weather-data_weather_history .

tool-coupler-r:tool.weather-data.weather-data_weather_history a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather-data.weather-data_weather_history ;
    tool-coupler-ont:toolOf tool-coupler-r:server.weather-data .

