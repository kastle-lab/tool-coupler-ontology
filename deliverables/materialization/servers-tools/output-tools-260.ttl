@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.twelvedata a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "twelvedata"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.twelvedata .

tool-coupler-r:metadata.twelvedata.twelvedata_GetTimeSeriesAtr a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "The Average True Range (ATR) is a volatility indicator that measures the average range of price movement over a specified period, helping traders assess market volatility."^^xsd:string ;
    tool-coupler-ont:hasName "twelvedata_GetTimeSeriesAtr"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesAtr .

tool-coupler-r:server.twelvedata a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesAtr .

tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesAtr a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata.twelvedata_GetTimeSeriesAtr ;
    tool-coupler-ont:toolOf tool-coupler-r:server.twelvedata .

