@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.airtable a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "airtable"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.airtable .

tool-coupler-r:metadata.airtable.airtable_create_table a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Create a new table in a base"^^xsd:string ;
    tool-coupler-ont:hasName "airtable_create_table"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.airtable.airtable_create_table .

tool-coupler-r:server.airtable a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.airtable.airtable_create_table .

tool-coupler-r:tool.airtable.airtable_create_table a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable.airtable_create_table ;
    tool-coupler-ont:toolOf tool-coupler-r:server.airtable .

