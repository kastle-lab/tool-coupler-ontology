@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.arxiv a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "arxiv"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.arxiv .

tool-coupler-r:metadata.arxiv.arxiv_list_papers a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "List all existing papers available as resources"^^xsd:string ;
    tool-coupler-ont:hasName "arxiv_list_papers"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.arxiv.arxiv_list_papers .

tool-coupler-r:server.arxiv a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.arxiv ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.arxiv.arxiv_list_papers .

tool-coupler-r:tool.arxiv.arxiv_list_papers a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.arxiv.arxiv_list_papers ;
    tool-coupler-ont:toolOf tool-coupler-r:server.arxiv .

