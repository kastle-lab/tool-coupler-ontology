@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.lara-translate a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "lara-translate"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.lara-translate .

tool-coupler-r:metadata.lara-translate.lara-translate_list_memories a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Lists all translation memories in your Lara Translate account."^^xsd:string ;
    tool-coupler-ont:hasName "lara-translate_list_memories"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.lara-translate.lara-translate_list_memories .

tool-coupler-r:server.lara-translate a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.lara-translate.lara-translate_list_memories .

tool-coupler-r:tool.lara-translate.lara-translate_list_memories a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_list_memories ;
    tool-coupler-ont:toolOf tool-coupler-r:server.lara-translate .

