@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.twelvedata a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "twelvedata"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.twelvedata .

tool-coupler-r:metadata.twelvedata.twelvedata_GetDividends a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Returns the amount of dividends paid out for the last 10+ years."^^xsd:string ;
    tool-coupler-ont:hasName "twelvedata_GetDividends"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.twelvedata.twelvedata_GetDividends .

tool-coupler-r:server.twelvedata a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.twelvedata.twelvedata_GetDividends .

tool-coupler-r:tool.twelvedata.twelvedata_GetDividends a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata.twelvedata_GetDividends ;
    tool-coupler-ont:toolOf tool-coupler-r:server.twelvedata .

