@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.twelvedata a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "twelvedata"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.twelvedata .

tool-coupler-r:metadata.twelvedata.twelvedata_GetEarliestTimestamp a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "This method returns the first available DateTime for a given instrument at the specific interval."^^xsd:string ;
    tool-coupler-ont:hasName "twelvedata_GetEarliestTimestamp"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.twelvedata.twelvedata_GetEarliestTimestamp .

tool-coupler-r:server.twelvedata a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.twelvedata.twelvedata_GetEarliestTimestamp .

tool-coupler-r:tool.twelvedata.twelvedata_GetEarliestTimestamp a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata.twelvedata_GetEarliestTimestamp ;
    tool-coupler-ont:toolOf tool-coupler-r:server.twelvedata .

