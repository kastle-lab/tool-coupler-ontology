@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.twelvedata a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "twelvedata"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.twelvedata .

tool-coupler-r:metadata.twelvedata.twelvedata_GetTimeSeriesBBands a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Bollinger Bands (BBANDS) are volatility bands placed above and below a moving average, measuring price volatility and helping traders identify potential overbought or oversold conditions."^^xsd:string ;
    tool-coupler-ont:hasName "twelvedata_GetTimeSeriesBBands"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesBBands .

tool-coupler-r:server.twelvedata a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesBBands .

tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesBBands a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata.twelvedata_GetTimeSeriesBBands ;
    tool-coupler-ont:toolOf tool-coupler-r:server.twelvedata .

