@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.filesystem a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "filesystem"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.filesystem .

tool-coupler-r:metadata.filesystem.filesystem_list_allowed_directories a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Returns the list of directories that this server is allowed to access. Subdirectories within these allowed directories are also accessible. Use this to understand which directories and their nested paths are available before trying to access files."^^xsd:string ;
    tool-coupler-ont:hasName "filesystem_list_allowed_directories"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.filesystem.filesystem_list_allowed_directories .

tool-coupler-r:server.filesystem a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.filesystem.filesystem_list_allowed_directories .

tool-coupler-r:tool.filesystem.filesystem_list_allowed_directories a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.filesystem.filesystem_list_allowed_directories ;
    tool-coupler-ont:toolOf tool-coupler-r:server.filesystem .

