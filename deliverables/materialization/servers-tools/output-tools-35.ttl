@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.ddg-search a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "ddg-search"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.ddg-search .

tool-coupler-r:metadata.ddg-search.ddg-search_search a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Search DuckDuckGo and return formatted results.

Args:
    query: The search query string
    max_results: Maximum number of results to return (default: 10)
    ctx: MCP context for logging"""^^xsd:string ;
    tool-coupler-ont:hasName "ddg-search_search"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.ddg-search.ddg-search_search .

tool-coupler-r:server.ddg-search a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.ddg-search ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.ddg-search.ddg-search_search .

tool-coupler-r:tool.ddg-search.ddg-search_search a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.ddg-search.ddg-search_search ;
    tool-coupler-ont:toolOf tool-coupler-r:server.ddg-search .

