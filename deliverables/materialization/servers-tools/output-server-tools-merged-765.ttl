@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.pubmed a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "pubmed"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.pubmed .

tool-coupler-r:metadata.pubmed.pubmed_search_pubmed_advanced a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "pubmed_search_pubmed_advanced"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.pubmed.pubmed_search_pubmed_advanced .

tool-coupler-r:server.pubmed a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.pubmed ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.pubmed.pubmed_search_pubmed_advanced .

tool-coupler-r:tool.pubmed.pubmed_search_pubmed_advanced a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.pubmed.pubmed_search_pubmed_advanced ;
    tool-coupler-ont:toolOf tool-coupler-r:server.pubmed .

