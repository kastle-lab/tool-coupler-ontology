@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.slack a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "slack"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.slack .

tool-coupler-r:metadata.slack.slack_channels_list a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get list of channels"^^xsd:string ;
    tool-coupler-ont:hasName "slack_channels_list"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.slack.slack_channels_list .

tool-coupler-r:server.slack a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.slack.slack_channels_list .

tool-coupler-r:tool.slack.slack_channels_list a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_channels_list ;
    tool-coupler-ont:toolOf tool-coupler-r:server.slack .

