@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.memory a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "memory"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.memory .

tool-coupler-r:metadata.memory.memory_search_nodes a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search for nodes in the knowledge graph based on a query"^^xsd:string ;
    tool-coupler-ont:hasName "memory_search_nodes"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.memory.memory_search_nodes .

tool-coupler-r:server.memory a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.memory.memory_search_nodes .

tool-coupler-r:tool.memory.memory_search_nodes a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.memory.memory_search_nodes ;
    tool-coupler-ont:toolOf tool-coupler-r:server.memory .

