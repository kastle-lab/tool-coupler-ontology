@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.met-museum a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "met-museum"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.met-museum .

tool-coupler-r:metadata.met-museum.met-museum_get-museum-object a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get a museum object by its ID, from the Metropolitan Museum of Art Collection"^^xsd:string ;
    tool-coupler-ont:hasName "met-museum_get-museum-object"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.met-museum.met-museum_get-museum-object .

tool-coupler-r:server.met-museum a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.met-museum ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.met-museum.met-museum_get-museum-object .

tool-coupler-r:tool.met-museum.met-museum_get-museum-object a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.met-museum.met-museum_get-museum-object ;
    tool-coupler-ont:toolOf tool-coupler-r:server.met-museum .

