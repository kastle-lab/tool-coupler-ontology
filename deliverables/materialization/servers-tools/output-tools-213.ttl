@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.open-library a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "open-library"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.open-library .

tool-coupler-r:metadata.open-library.open-library_get_book_by_title a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search for a book by its title on Open Library."^^xsd:string ;
    tool-coupler-ont:hasName "open-library_get_book_by_title"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.open-library.open-library_get_book_by_title .

tool-coupler-r:server.open-library a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.open-library ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.open-library.open-library_get_book_by_title .

tool-coupler-r:tool.open-library.open-library_get_book_by_title a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.open-library.open-library_get_book_by_title ;
    tool-coupler-ont:toolOf tool-coupler-r:server.open-library .

