@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.met-museum a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "met-museum"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.met-museum .

tool-coupler-r:metadata.met-museum.met-museum_search-museum-objects a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search for objects in the Metropolitan Museum of Art (Met Museum). Will return Total objects found, followed by a list of Object Ids.The parameter title should be set to true if you want to search for objects by title.The parameter hasImages is false by default, but can be set to true to return objects without images.If the parameter hasImages is true, the parameter title should be false."^^xsd:string ;
    tool-coupler-ont:hasName "met-museum_search-museum-objects"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.met-museum.met-museum_search-museum-objects .

tool-coupler-r:server.met-museum a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.met-museum ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.met-museum.met-museum_search-museum-objects .

tool-coupler-r:tool.met-museum.met-museum_search-museum-objects a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.met-museum.met-museum_search-museum-objects ;
    tool-coupler-ont:toolOf tool-coupler-r:server.met-museum .

