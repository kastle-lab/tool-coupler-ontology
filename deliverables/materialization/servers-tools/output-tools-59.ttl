@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.exa a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "exa"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.exa .

tool-coupler-r:metadata.exa.exa_web_search_exa a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Search the web using Exa AI - performs real-time web searches and can scrape content from specific URLs. Supports configurable result counts and returns the content from the most relevant websites."^^xsd:string ;
    tool-coupler-ont:hasName "exa_web_search_exa"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.exa.exa_web_search_exa .

tool-coupler-r:server.exa a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.exa ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.exa.exa_web_search_exa .

tool-coupler-r:tool.exa.exa_web_search_exa a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.exa.exa_web_search_exa ;
    tool-coupler-ont:toolOf tool-coupler-r:server.exa .

