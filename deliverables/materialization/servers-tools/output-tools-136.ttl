@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.lara-translate a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "lara-translate"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.lara-translate .

tool-coupler-r:metadata.lara-translate.lara-translate_translate a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Translate text between languages with support for language detection, context-aware translations and translation memories using Lara Translate."^^xsd:string ;
    tool-coupler-ont:hasName "lara-translate_translate"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.lara-translate.lara-translate_translate .

tool-coupler-r:server.lara-translate a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.lara-translate.lara-translate_translate .

tool-coupler-r:tool.lara-translate.lara-translate_translate a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.lara-translate.lara-translate_translate ;
    tool-coupler-ont:toolOf tool-coupler-r:server.lara-translate .

