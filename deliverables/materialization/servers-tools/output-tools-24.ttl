@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.arxiv a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "arxiv"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.arxiv .

tool-coupler-r:metadata.arxiv.arxiv_read_paper a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Read the full content of a stored paper in markdown format"^^xsd:string ;
    tool-coupler-ont:hasName "arxiv_read_paper"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.arxiv.arxiv_read_paper .

tool-coupler-r:server.arxiv a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.arxiv ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.arxiv.arxiv_read_paper .

tool-coupler-r:tool.arxiv.arxiv_read_paper a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.arxiv.arxiv_read_paper ;
    tool-coupler-ont:toolOf tool-coupler-r:server.arxiv .

