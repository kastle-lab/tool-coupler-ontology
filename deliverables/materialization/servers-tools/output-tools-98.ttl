@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.github a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "github"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.github .

tool-coupler-r:metadata.github.github_get_repository a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get detailed information about a GitHub repository including README and file structure"^^xsd:string ;
    tool-coupler-ont:hasName "github_get_repository"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.github.github_get_repository .

tool-coupler-r:server.github a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.github.github_get_repository .

tool-coupler-r:tool.github.github_get_repository a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_get_repository ;
    tool-coupler-ont:toolOf tool-coupler-r:server.github .

