@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.mongodb a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "mongodb"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.mongodb .

tool-coupler-r:metadata.mongodb.mongodb_switch-connection a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Switch to a different MongoDB connection. If the user has configured a connection string or has previously called the connect tool, a connection is already established and there's no need to call this tool unless the user has explicitly requested to switch to a new instance."^^xsd:string ;
    tool-coupler-ont:hasName "mongodb_switch-connection"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.mongodb.mongodb_switch-connection .

tool-coupler-r:server.mongodb a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mongodb ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.mongodb.mongodb_switch-connection .

tool-coupler-r:tool.mongodb.mongodb_switch-connection a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mongodb.mongodb_switch-connection ;
    tool-coupler-ont:toolOf tool-coupler-r:server.mongodb .

