@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.whois a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "whois"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.whois .

tool-coupler-r:metadata.whois.whois_whois_as a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Looksup whois information about the Autonomous System Number (ASN)"^^xsd:string ;
    tool-coupler-ont:hasName "whois_whois_as"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.whois.whois_whois_as .

tool-coupler-r:server.whois a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.whois ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.whois.whois_whois_as .

tool-coupler-r:tool.whois.whois_whois_as a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.whois.whois_whois_as ;
    tool-coupler-ont:toolOf tool-coupler-r:server.whois .

