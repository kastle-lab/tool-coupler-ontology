@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "clinicaltrialsgov-mcp-server"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.clinicaltrialsgov-mcp-server .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Searches for clinical studies using a combination of query terms and filters. Supports pagination, sorting, and geographic filtering."^^xsd:string ;
    tool-coupler-ont:hasName "clinicaltrialsgov-mcp-server_clinicaltrials_list_studies"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies .

tool-coupler-r:server.clinicaltrialsgov-mcp-server a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies .

tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies ;
    tool-coupler-ont:toolOf tool-coupler-r:server.clinicaltrialsgov-mcp-server .

