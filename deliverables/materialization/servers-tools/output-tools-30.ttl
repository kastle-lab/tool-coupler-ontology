@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "clinicaltrialsgov-mcp-server"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.clinicaltrialsgov-mcp-server .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Fetches one or more clinical studies from ClinicalTrials.gov by their NCT IDs. Returns either complete study data or concise summaries for each."^^xsd:string ;
    tool-coupler-ont:hasName "clinicaltrialsgov-mcp-server_clinicaltrials_get_study"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study .

tool-coupler-r:server.clinicaltrialsgov-mcp-server a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study .

tool-coupler-r:tool.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_get_study ;
    tool-coupler-ont:toolOf tool-coupler-r:server.clinicaltrialsgov-mcp-server .

