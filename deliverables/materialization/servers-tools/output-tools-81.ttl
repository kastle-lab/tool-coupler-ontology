@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.git a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "git"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.git .

tool-coupler-r:metadata.git.git_git_reset a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Unstages all staged changes"^^xsd:string ;
    tool-coupler-ont:hasName "git_git_reset"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.git.git_git_reset .

tool-coupler-r:server.git a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.git ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.git.git_git_reset .

tool-coupler-r:tool.git.git_git_reset a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.git.git_git_reset ;
    tool-coupler-ont:toolOf tool-coupler-r:server.git .

