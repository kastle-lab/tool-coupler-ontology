@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.osm-mcp-server a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "osm-mcp-server"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.osm-mcp-server .

tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_find_ev_charging_stations a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Locate electric vehicle charging stations near a specific location.

This specialized search tool identifies EV charging infrastructure within a specified
distance from a location. Results can be filtered by connector type (Tesla, CCS, CHAdeMO, etc.)
and minimum power delivery. Essential for EV owners planning trips or evaluating potential
charging stops.

Args:
    latitude: Center point latitude (decimal degrees)
    longitude: Center point longitude (decimal degrees)
    radius: Search radius in meters (defaults to 5000m/5km)
    connector_types: Optional list of specific connector types to filter by
                    (e.g., ["type2", "ccs", "tesla"])
    min_power: Minimum charging power in kW
    
Returns:
    List of charging stations with:
    - Location name and operator
    - Available connector types
    - Charging speeds
    - Number of charging points
    - Access restrictions
    - Other relevant metadata"""^^xsd:string ;
    tool-coupler-ont:hasName "osm-mcp-server_find_ev_charging_stations"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_find_ev_charging_stations .

tool-coupler-r:server.osm-mcp-server a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_find_ev_charging_stations .

tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_find_ev_charging_stations a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_find_ev_charging_stations ;
    tool-coupler-ont:toolOf tool-coupler-r:server.osm-mcp-server .

