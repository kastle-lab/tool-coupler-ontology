@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.ddg-search a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "ddg-search"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.ddg-search .

tool-coupler-r:metadata.ddg-search.ddg-search_fetch_content a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Fetch and parse content from a webpage URL.

Args:
    url: The webpage URL to fetch content from
    ctx: MCP context for logging"""^^xsd:string ;
    tool-coupler-ont:hasName "ddg-search_fetch_content"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.ddg-search.ddg-search_fetch_content .

tool-coupler-r:server.ddg-search a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.ddg-search ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.ddg-search.ddg-search_fetch_content .

tool-coupler-r:tool.ddg-search.ddg-search_fetch_content a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.ddg-search.ddg-search_fetch_content ;
    tool-coupler-ont:toolOf tool-coupler-r:server.ddg-search .

