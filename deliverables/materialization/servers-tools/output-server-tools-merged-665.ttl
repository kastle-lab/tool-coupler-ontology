@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.osm-mcp-server a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "osm-mcp-server"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.osm-mcp-server .

tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_analyze_neighborhood a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Generate a comprehensive neighborhood analysis focused on livability factors.

This advanced analysis tool evaluates a neighborhood based on multiple livability factors,
including amenities, transportation options, green spaces, and services. Results include
counts and proximity scores for various categories, helping to assess the overall quality
and convenience of a residential area. Invaluable for real estate decisions, relocation
planning, and neighborhood comparisons.

Args:
    latitude: Center point latitude (decimal degrees)
    longitude: Center point longitude (decimal degrees)
    radius: Analysis radius in meters (defaults to 1000m/1km)
    
Returns:
    Comprehensive neighborhood profile including:
    - Overall neighborhood score
    - Walkability assessment
    - Public transportation access
    - Nearby amenities (shops, restaurants, services)
    - Green spaces and recreation
    - Education and healthcare facilities
    - Detailed counts and distance metrics for each category"""^^xsd:string ;
    tool-coupler-ont:hasName "osm-mcp-server_analyze_neighborhood"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_analyze_neighborhood .

tool-coupler-r:server.osm-mcp-server a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_analyze_neighborhood .

tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_analyze_neighborhood a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_analyze_neighborhood ;
    tool-coupler-ont:toolOf tool-coupler-r:server.osm-mcp-server .

