@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.twelvedata a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "twelvedata"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.twelvedata .

tool-coupler-r:metadata.twelvedata.twelvedata_GetExchanges a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "This API call returns an array of stock or ETF exchanges available at Twelve Data API. This list is updated daily."^^xsd:string ;
    tool-coupler-ont:hasName "twelvedata_GetExchanges"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.twelvedata.twelvedata_GetExchanges .

tool-coupler-r:server.twelvedata a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.twelvedata.twelvedata_GetExchanges .

tool-coupler-r:tool.twelvedata.twelvedata_GetExchanges a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata.twelvedata_GetExchanges ;
    tool-coupler-ont:toolOf tool-coupler-r:server.twelvedata .

