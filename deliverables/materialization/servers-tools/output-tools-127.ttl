@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.google-maps a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "google-maps"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.google-maps .

tool-coupler-r:metadata.google-maps.google-maps_maps_directions a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get directions between two points"^^xsd:string ;
    tool-coupler-ont:hasName "google-maps_maps_directions"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.google-maps.google-maps_maps_directions .

tool-coupler-r:server.google-maps a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.google-maps ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.google-maps.google-maps_maps_directions .

tool-coupler-r:tool.google-maps.google-maps_maps_directions a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.google-maps.google-maps_maps_directions ;
    tool-coupler-ont:toolOf tool-coupler-r:server.google-maps .

