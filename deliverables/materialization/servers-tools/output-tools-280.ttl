@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.weather a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "weather"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.weather .

tool-coupler-r:metadata.weather.weather_get_weather_forecast a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get multi-day weather forecast for a location in the United States. Perfect for 'What's the forecast for [US location]?' questions. Provides detailed day/night forecasts for up to 7 days."^^xsd:string ;
    tool-coupler-ont:hasName "weather_get_weather_forecast"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.weather.weather_get_weather_forecast .

tool-coupler-r:server.weather a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.weather.weather_get_weather_forecast .

tool-coupler-r:tool.weather.weather_get_weather_forecast a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.weather.weather_get_weather_forecast ;
    tool-coupler-ont:toolOf tool-coupler-r:server.weather .

