@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.github a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "github"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.github .

tool-coupler-r:metadata.github.github_create_pull_request_review_comment a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Create a review comment (line-by-line code comment) on a pull request."^^xsd:string ;
    tool-coupler-ont:hasName "github_create_pull_request_review_comment"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.github.github_create_pull_request_review_comment .

tool-coupler-r:server.github a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.github.github_create_pull_request_review_comment .

tool-coupler-r:tool.github.github_create_pull_request_review_comment a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.github.github_create_pull_request_review_comment ;
    tool-coupler-ont:toolOf tool-coupler-r:server.github .

