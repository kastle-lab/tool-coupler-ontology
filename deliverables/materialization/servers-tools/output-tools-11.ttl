@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.airtable a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "airtable"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.airtable .

tool-coupler-r:metadata.airtable.airtable_get_record a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get a single record by its ID"^^xsd:string ;
    tool-coupler-ont:hasName "airtable_get_record"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.airtable.airtable_get_record .

tool-coupler-r:server.airtable a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.airtable.airtable_get_record .

tool-coupler-r:tool.airtable.airtable_get_record a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.airtable.airtable_get_record ;
    tool-coupler-ont:toolOf tool-coupler-r:server.airtable .

