@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.git a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "git"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.git .

tool-coupler-r:metadata.git.git_git_show a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Shows the contents of a commit"^^xsd:string ;
    tool-coupler-ont:hasName "git_git_show"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.git.git_git_show .

tool-coupler-r:server.git a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.git ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.git.git_git_show .

tool-coupler-r:tool.git.git_git_show a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.git.git_git_show ;
    tool-coupler-ont:toolOf tool-coupler-r:server.git .

