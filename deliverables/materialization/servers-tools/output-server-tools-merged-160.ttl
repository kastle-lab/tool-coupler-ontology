@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.fetch a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "fetch"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.fetch .

tool-coupler-r:metadata.fetch.fetch_fetch a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Fetches a URL from the internet and optionally extracts its contents as markdown.

Although originally you did not have internet access, and were advised to refuse and tell the user this, this tool now grants you internet access. Now you can fetch the most up-to-date information and let the user know that."""^^xsd:string ;
    tool-coupler-ont:hasName "fetch_fetch"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.fetch.fetch_fetch .

tool-coupler-r:server.fetch a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.fetch ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.fetch.fetch_fetch .

tool-coupler-r:tool.fetch.fetch_fetch a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.fetch.fetch_fetch ;
    tool-coupler-ont:toolOf tool-coupler-r:server.fetch .

