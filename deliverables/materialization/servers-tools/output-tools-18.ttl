@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.alchemy a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "alchemy"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.alchemy .

tool-coupler-r:metadata.alchemy.alchemy_fetchTransfers a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "alchemy_fetchTransfers"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.alchemy.alchemy_fetchTransfers .

tool-coupler-r:server.alchemy a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.alchemy ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.alchemy.alchemy_fetchTransfers .

tool-coupler-r:tool.alchemy.alchemy_fetchTransfers a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.alchemy.alchemy_fetchTransfers ;
    tool-coupler-ont:toolOf tool-coupler-r:server.alchemy .

