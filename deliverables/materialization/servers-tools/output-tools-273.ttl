@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.twelvedata a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "twelvedata"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.twelvedata .

tool-coupler-r:metadata.twelvedata.twelvedata_GetTimeSeriesCross a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "This API call returns meta and cross rate time series for the requested instruments. Metaobject consists of general information about the requested symbol. Time series is the array of objects ordered by time descending with Open, High, Low, Close prices. Works with stocks, forex and cryptocurrency."^^xsd:string ;
    tool-coupler-ont:hasName "twelvedata_GetTimeSeriesCross"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesCross .

tool-coupler-r:server.twelvedata a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesCross .

tool-coupler-r:tool.twelvedata.twelvedata_GetTimeSeriesCross a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.twelvedata.twelvedata_GetTimeSeriesCross ;
    tool-coupler-ont:toolOf tool-coupler-r:server.twelvedata .

