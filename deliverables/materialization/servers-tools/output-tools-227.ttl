@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.osm-mcp-server a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "osm-mcp-server"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.osm-mcp-server .

tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_analyze_commute a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Perform a detailed commute analysis between home and work locations.

This advanced tool analyzes commute options between two locations (typically home and work),
comparing multiple transportation modes and providing detailed metrics for each option.
Includes estimated travel times, distances, turn-by-turn directions, and other commute-relevant
data. Essential for real estate decisions, lifestyle planning, and workplace relocation analysis.

Args:
    home_latitude: Home location latitude (decimal degrees)
    home_longitude: Home location longitude (decimal degrees)
    work_latitude: Workplace location latitude (decimal degrees)
    work_longitude: Workplace location longitude (decimal degrees)
    modes: List of transportation modes to analyze (options: "car", "foot", "bike")
    depart_at: Optional departure time (format: "HH:MM") for time-sensitive routing
    
Returns:
    Comprehensive commute analysis with:
    - Summary comparing all transportation modes
    - Detailed route information for each mode
    - Total distance and duration for each option
    - Turn-by-turn directions"""^^xsd:string ;
    tool-coupler-ont:hasName "osm-mcp-server_analyze_commute"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_analyze_commute .

tool-coupler-r:server.osm-mcp-server a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_analyze_commute .

tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_analyze_commute a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_analyze_commute ;
    tool-coupler-ont:toolOf tool-coupler-r:server.osm-mcp-server .

