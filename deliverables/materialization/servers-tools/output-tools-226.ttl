@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.osm-mcp-server a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "osm-mcp-server"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.osm-mcp-server .

tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_find_schools_nearby a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """Locate educational institutions near a specific location, filtered by education level.

This specialized search tool identifies schools, colleges, and other educational institutions
within a specified distance from a location. Results can be filtered by education level
(elementary, middle, high school, university, etc.). Essential for families evaluating
neighborhoods or real estate purchases with education considerations.

Args:
    latitude: Center point latitude (decimal degrees)
    longitude: Center point longitude (decimal degrees)
    radius: Search radius in meters (defaults to 2000m/2km)
    education_levels: Optional list of specific education levels to filter by
                     (e.g., ["elementary", "secondary", "university"])
    
Returns:
    List of educational institutions with:
    - Name and type
    - Distance from search point
    - Education levels offered
    - Contact information if available
    - Other relevant metadata"""^^xsd:string ;
    tool-coupler-ont:hasName "osm-mcp-server_find_schools_nearby"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_find_schools_nearby .

tool-coupler-r:server.osm-mcp-server a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_find_schools_nearby .

tool-coupler-r:tool.osm-mcp-server.osm-mcp-server_find_schools_nearby a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.osm-mcp-server.osm-mcp-server_find_schools_nearby ;
    tool-coupler-ont:toolOf tool-coupler-r:server.osm-mcp-server .

