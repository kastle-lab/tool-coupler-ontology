@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.open-library a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "open-library"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.open-library .

tool-coupler-r:metadata.open-library.open-library_get_author_info a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get detailed information for a specific author using their Open Library Author Key (e.g. OL23919A)."^^xsd:string ;
    tool-coupler-ont:hasName "open-library_get_author_info"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.open-library.open-library_get_author_info .

tool-coupler-r:server.open-library a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.open-library ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.open-library.open-library_get_author_info .

tool-coupler-r:tool.open-library.open-library_get_author_info a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.open-library.open-library_get_author_info ;
    tool-coupler-ont:toolOf tool-coupler-r:server.open-library .

