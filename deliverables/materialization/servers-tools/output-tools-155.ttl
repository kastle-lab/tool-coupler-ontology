@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.mcp-server-code-runner a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "mcp-server-code-runner"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.mcp-server-code-runner .

tool-coupler-r:metadata.mcp-server-code-runner.mcp-server-code-runner_run-code a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Run code snippet and return the result."^^xsd:string ;
    tool-coupler-ont:hasName "mcp-server-code-runner_run-code"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.mcp-server-code-runner.mcp-server-code-runner_run-code .

tool-coupler-r:server.mcp-server-code-runner a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mcp-server-code-runner ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.mcp-server-code-runner.mcp-server-code-runner_run-code .

tool-coupler-r:tool.mcp-server-code-runner.mcp-server-code-runner_run-code a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.mcp-server-code-runner.mcp-server-code-runner_run-code ;
    tool-coupler-ont:toolOf tool-coupler-r:server.mcp-server-code-runner .

