@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.desktop-commander a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "desktop-commander"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.desktop-commander .

tool-coupler-r:metadata.desktop-commander.desktop-commander_list_sessions a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription """List all active terminal sessions.
                        
                        Shows session status including:
                        - PID: Process identifier  
                        - Blocked: Whether session is waiting for input
                        - Runtime: How long the session has been running
                        
                        DEBUGGING REPLs:
                        - "Blocked: true" often means REPL is waiting for input
                        - Use this to verify sessions are running before sending input
                        - Long runtime with blocked status may indicate stuck process
                        
                        This command can be referenced as "DC: ..." or "use Desktop Commander to ..." in your instructions."""^^xsd:string ;
    tool-coupler-ont:hasName "desktop-commander_list_sessions"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.desktop-commander.desktop-commander_list_sessions .

tool-coupler-r:server.desktop-commander a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.desktop-commander ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.desktop-commander.desktop-commander_list_sessions .

tool-coupler-r:tool.desktop-commander.desktop-commander_list_sessions a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.desktop-commander.desktop-commander_list_sessions ;
    tool-coupler-ont:toolOf tool-coupler-r:server.desktop-commander .

