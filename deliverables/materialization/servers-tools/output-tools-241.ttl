@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:metadata.slack a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "slack"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:server.slack .

tool-coupler-r:metadata.slack.slack_conversations_history a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasDescription "Get messages from the channel (or DM) by channel_id, the last row/column in the response is used as 'cursor' parameter for pagination if not empty"^^xsd:string ;
    tool-coupler-ont:hasName "slack_conversations_history"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:tool.slack.slack_conversations_history .

tool-coupler-r:server.slack a tool-coupler-ont:Server ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack ;
    tool-coupler-ont:hasTool tool-coupler-r:tool.slack.slack_conversations_history .

tool-coupler-r:tool.slack.slack_conversations_history a tool-coupler-ont:Tool ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.slack.slack_conversations_history ;
    tool-coupler-ont:toolOf tool-coupler-r:server.slack .

