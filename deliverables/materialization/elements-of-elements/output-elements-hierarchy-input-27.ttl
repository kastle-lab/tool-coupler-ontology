@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-coupler/lod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tool-coupler-r:dataType.String a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.notion.notion_API-post-page.properties.Input.properties.title.text.content .

tool-coupler-r:element.notion.notion_API-post-page.properties.Input.properties.title.text a tool-coupler-ont:Element ;
    tool-coupler-ont:containsElement tool-coupler-r:element.notion.notion_API-post-page.properties.Input.properties.title.text.content .

tool-coupler-r:metadata.notion.notion_API-post-page.properties.Input.properties.title.text.content a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "content"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.notion.notion_API-post-page.properties.Input.properties.title.text.content .

tool-coupler-r:element.notion.notion_API-post-page.properties.Input.properties.title.text.content a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:element.notion.notion_API-post-page.properties.Input.properties.title.text ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.notion.notion_API-post-page.properties.Input.properties.title.text.content ;
    tool-coupler-ont:isOfDataType tool-coupler-r:dataType.String .

