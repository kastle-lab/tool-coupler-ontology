@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Number.> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.longitude .

tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.geo a tool-coupler-ont:Element ;
    tool-coupler-ont:containsElement tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.longitude .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.longitude a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "longitude"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.longitude .

tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.longitude a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.geo ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_list_studies.filter.Input.longitude ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean...Number.> .

