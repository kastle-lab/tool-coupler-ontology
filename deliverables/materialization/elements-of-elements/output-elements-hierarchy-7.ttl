@prefix tool-coupler-ont: <https://kastle-lab.github.io/tool-couplerlod/ontology/> .
@prefix tool-coupler-r: <https://kastle-lab.github.io/tool-couplerlod/resource/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://kastle-lab.github.io/tool-couplerlod/resource/boolean.String...> a tool-coupler-ont:DataType ;
    tool-coupler-ont:dataTypeOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.unit .

tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.geo a tool-coupler-ont:Element ;
    tool-coupler-ont:containsElement tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.unit .

tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.unit a tool-coupler-ont:Metadata ;
    tool-coupler-ont:hasName "unit"^^xsd:string ;
    tool-coupler-ont:metadataOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.unit .

tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.unit a tool-coupler-ont:Element ;
    tool-coupler-ont:elementOf tool-coupler-r:element.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.geo ;
    tool-coupler-ont:hasMetadata tool-coupler-r:metadata.clinicaltrialsgov-mcp-server.clinicaltrialsgov-mcp-server_clinicaltrials_analyze_trends.filter.Input.unit ;
    tool-coupler-ont:isOfDataType <https://kastle-lab.github.io/tool-couplerlod/resource/boolean.String...> .

