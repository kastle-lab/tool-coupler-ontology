@prefix : <https://kastle-lab.github.io/tool-coupler/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://kastle-lab.github.io/tool-coupler/> .

<https://kastle-lab.github.io/tool-coupler> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  https://kastle-lab.github.io/tool-coupler/containsElement
:containsElement rdf:type owl:ObjectProperty ;
                 rdfs:range :Element .


###  https://kastle-lab.github.io/tool-coupler/hasFormat
:hasFormat rdf:type owl:ObjectProperty ;
           rdfs:domain :Metadata ;
           rdfs:range :Format .


###  https://kastle-lab.github.io/tool-coupler/hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain :Metadata ;
             rdfs:range :Location .


###  https://kastle-lab.github.io/tool-coupler/hasMetadata
:hasMetadata rdf:type owl:ObjectProperty ;
             rdfs:range :Metadata .


###  https://kastle-lab.github.io/tool-coupler/hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              rdfs:domain :Tool ;
              rdfs:range :Parameter .


###  https://kastle-lab.github.io/tool-coupler/hasRequirementStatus
:hasRequirementStatus rdf:type owl:ObjectProperty ;
                      rdfs:domain :Parameter ;
                      rdfs:range :RequirementStatus .


###  https://kastle-lab.github.io/tool-coupler/hasResource
:hasResource rdf:type owl:ObjectProperty ;
             rdfs:domain :Server ;
             rdfs:range :Resource .


###  https://kastle-lab.github.io/tool-coupler/hasTool
:hasTool rdf:type owl:ObjectProperty ;
         rdfs:domain :Server ;
         rdfs:range :Tool .


###  https://kastle-lab.github.io/tool-coupler/isOfDataType
:isOfDataType rdf:type owl:ObjectProperty ;
              rdfs:range :DataType .


###  https://kastle-lab.github.io/tool-coupler/isOfResourceClass
:isOfResourceClass rdf:type owl:ObjectProperty ;
                   rdfs:domain :Resource ;
                   rdfs:range :ResourceClass .


#################################################################
#    Data properties
#################################################################

###  https://kastle-lab.github.io/tool-coupler/asString
:asString rdf:type owl:DatatypeProperty ;
          rdfs:range rdfs:Literal ,
                     xsd:string .


###  https://kastle-lab.github.io/tool-coupler/hasDescription
:hasDescription rdf:type owl:DatatypeProperty ;
                rdfs:domain :Metadata ;
                rdfs:range xsd:string .


###  https://kastle-lab.github.io/tool-coupler/hasFilePath
:hasFilePath rdf:type owl:DatatypeProperty ;
             rdfs:domain :Location ;
             rdfs:range rdfs:Literal .


###  https://kastle-lab.github.io/tool-coupler/hasIP
:hasIP rdf:type owl:DatatypeProperty ;
       rdfs:domain :Location ;
       rdfs:range rdfs:Literal .


###  https://kastle-lab.github.io/tool-coupler/hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:domain :Metadata ;
         rdfs:range xsd:string .


###  https://kastle-lab.github.io/tool-coupler/hasTag
:hasTag rdf:type owl:DatatypeProperty ;
        rdfs:domain :Metadata ;
        rdfs:range xsd:string .


###  https://kastle-lab.github.io/tool-coupler/hasURI
:hasURI rdf:type owl:DatatypeProperty ;
        rdfs:domain :Location ;
        rdfs:range rdfs:Literal .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :containsElement ;
                            owl:allValuesFrom :Element
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasFormat ;
                            owl:allValuesFrom :Format
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocation ;
                            owl:allValuesFrom :Location
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasMetadata ;
                            owl:allValuesFrom :Metadata
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasParameter ;
                            owl:allValuesFrom :Parameter
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasRequirementStatus ;
                            owl:allValuesFrom :RequirementStatus
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasTool ;
                            owl:allValuesFrom :Tool
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :isOfDataType ;
                            owl:allValuesFrom :DataType
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :asString ;
                            owl:allValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasDescription ;
                            owl:allValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasFilePath ;
                            owl:allValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIP ;
                            owl:allValuesFrom xsd:anyURI
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasName ;
                            owl:allValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasURI ;
                            owl:allValuesFrom xsd:anyURI
                          ] .


###  https://kastle-lab.github.io/tool-coupler/DataType
:DataType rdf:type owl:Class ;
          owl:disjointWith :Element ,
                           :Parameter .


###  https://kastle-lab.github.io/tool-coupler/Element
:Element rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasMetadata ;
                           owl:someValuesFrom :Metadata
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isOfDataType ;
                           owl:someValuesFrom :DataType
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasMetadata ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Metadata
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isOfDataType ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :DataType
                         ] ;
         owl:disjointWith :Metadata ,
                          :Parameter .


###  https://kastle-lab.github.io/tool-coupler/Format
:Format rdf:type owl:Class ;
        owl:disjointWith :Metadata .


###  https://kastle-lab.github.io/tool-coupler/Inout
:Inout rdf:type owl:Class ;
       rdfs:subClassOf :Parameter .


###  https://kastle-lab.github.io/tool-coupler/Input
:Input rdf:type owl:Class ;
       rdfs:subClassOf :Parameter .


###  https://kastle-lab.github.io/tool-coupler/Location
:Location rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty [ owl:inverseOf :hasLocation
                                           ] ;
                            owl:someValuesFrom :Metadata
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :asString ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasFilePath ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIP ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:anyURI
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasURI ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:anyURI
                          ] ;
          owl:disjointWith :Metadata .


###  https://kastle-lab.github.io/tool-coupler/Metadata
:Metadata rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasFormat ;
                            owl:someValuesFrom :Format
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasFormat ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Format
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasLocation ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Location
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty [ owl:inverseOf :hasMetadata
                                           ] ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasName ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasDescription ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasName ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ;
          owl:disjointWith :Parameter ,
                           :Server ,
                           :Tool .


###  https://kastle-lab.github.io/tool-coupler/Output
:Output rdf:type owl:Class ;
        rdfs:subClassOf :Parameter .


###  https://kastle-lab.github.io/tool-coupler/Parameter
:Parameter rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :hasMetadata ;
                             owl:someValuesFrom :Metadata
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasRequirementStatus ;
                             owl:someValuesFrom :RequirementStatus
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isOfDataType ;
                             owl:someValuesFrom :DataType
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty [ owl:inverseOf :hasParameter
                                            ] ;
                             owl:someValuesFrom :Tool
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasMetadata ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Metadata
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasRequirementStatus ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :RequirementStatus
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isOfDataType ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :DataType
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty [ owl:inverseOf :hasParameter
                                            ] ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Tool
                           ] ;
           owl:disjointWith :RequirementStatus ,
                            :Tool .


###  https://kastle-lab.github.io/tool-coupler/RequirementStatus
:RequirementStatus rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty [ owl:inverseOf :hasRequirementStatus
                                                    ] ;
                                     owl:someValuesFrom :Parameter
                                   ] .


###  https://kastle-lab.github.io/tool-coupler/Resource
:Resource rdf:type owl:Class .


###  https://kastle-lab.github.io/tool-coupler/ResourceClass
:ResourceClass rdf:type owl:Class .


###  https://kastle-lab.github.io/tool-coupler/Server
:Server rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :hasMetadata ;
                          owl:someValuesFrom :Metadata
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasTool ;
                          owl:someValuesFrom :Tool
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasMetadata ;
                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Metadata
                        ] ;
        owl:disjointWith :Tool .


###  https://kastle-lab.github.io/tool-coupler/Tool
:Tool rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :hasMetadata ;
                        owl:someValuesFrom :Metadata
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty [ owl:inverseOf :hasTool
                                       ] ;
                        owl:someValuesFrom :Server
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasMetadata ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Metadata
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty [ owl:inverseOf :hasTool
                                       ] ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Server
                      ] .


#################################################################
#    Individuals
#################################################################

###  https://kastle-lab.github.io/tool-coupler#Optional
:Optional rdf:type owl:NamedIndividual ,
                   :RequirementStatus .


###  https://kastle-lab.github.io/tool-coupler#Required
:Required rdf:type owl:NamedIndividual ,
                   :RequirementStatus .


###  https://kastle-lab.github.io/tool-coupler/Array
:Array rdf:type owl:NamedIndividual ,
                :DataType .


###  https://kastle-lab.github.io/tool-coupler/Audio
:Audio rdf:type owl:NamedIndividual ,
                :Format .


###  https://kastle-lab.github.io/tool-coupler/Binary
:Binary rdf:type owl:NamedIndividual ,
                 :ResourceClass .


###  https://kastle-lab.github.io/tool-coupler/Boolean
:Boolean rdf:type owl:NamedIndividual ,
                  :DataType .


###  https://kastle-lab.github.io/tool-coupler/Dictionary
:Dictionary rdf:type owl:NamedIndividual ,
                     :DataType .


###  https://kastle-lab.github.io/tool-coupler/Directory
:Directory rdf:type owl:NamedIndividual ,
                    :ResourceClass .


###  https://kastle-lab.github.io/tool-coupler/File
:File rdf:type owl:NamedIndividual ,
               :ResourceClass .


###  https://kastle-lab.github.io/tool-coupler/Float
:Float rdf:type owl:NamedIndividual ,
                :DataType .


###  https://kastle-lab.github.io/tool-coupler/Function
:Function rdf:type owl:NamedIndividual ,
                   :ResourceClass .


###  https://kastle-lab.github.io/tool-coupler/HTTP
:HTTP rdf:type owl:NamedIndividual ,
               :ResourceClass .


###  https://kastle-lab.github.io/tool-coupler/Image
:Image rdf:type owl:NamedIndividual ,
                :Format .


###  https://kastle-lab.github.io/tool-coupler/Integer
:Integer rdf:type owl:NamedIndividual ,
                  :DataType .


###  https://kastle-lab.github.io/tool-coupler/Object
:Object rdf:type owl:NamedIndividual ,
                 :DataType .


###  https://kastle-lab.github.io/tool-coupler/Set
:Set rdf:type owl:NamedIndividual ,
              :DataType .


###  https://kastle-lab.github.io/tool-coupler/String
:String rdf:type owl:NamedIndividual ,
                 :DataType .


###  https://kastle-lab.github.io/tool-coupler/Text
:Text rdf:type owl:NamedIndividual ,
               :ResourceClass .


###  https://kastle-lab.github.io/tool-coupler/Video
:Video rdf:type owl:NamedIndividual ,
                :Format .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
  owl:onProperty :hasFormat ;
  owl:someValuesFrom owl:Thing ;
  rdfs:subClassOf :Metadata
] .


[ rdf:type owl:Restriction ;
  owl:onProperty :hasLocation ;
  owl:someValuesFrom owl:Thing ;
  rdfs:subClassOf :Metadata
] .


[ rdf:type owl:Restriction ;
  owl:onProperty :hasParameter ;
  owl:someValuesFrom owl:Thing ;
  rdfs:subClassOf :Tool
] .


[ rdf:type owl:Restriction ;
  owl:onProperty :hasRequirementStatus ;
  owl:someValuesFrom owl:Thing ;
  rdfs:subClassOf :Parameter
] .


[ rdf:type owl:Restriction ;
  owl:onProperty :hasTool ;
  owl:someValuesFrom owl:Thing ;
  rdfs:subClassOf :Server
] .


