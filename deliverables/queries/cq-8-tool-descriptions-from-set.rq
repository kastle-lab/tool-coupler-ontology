# CQ 8 - What are the descriptions of the Tools from a given set of available Tools?

PREFIX tc-ont: <https://kastle-lab.github.io/tool-coupler/lod/ontology/>
PREFIX tc-r:   <https://kastle-lab.github.io/tool-coupler/lod/resource/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?serverName ?toolName ?toolDescription
WHERE {
  VALUES ?toolName { 
    "fetch_fetch"^^xsd:string
    "whois_whois_domain"^^xsd:string
    "github_search_repositories"^^xsd:string
    "github_search_code"^^xsd:string
    "github_search_users"^^xsd:string
    "github_get_issue"^^xsd:string
    "github_list_issues"^^xsd:string
    "github_search_issues"^^xsd:string
    "github_get_issue_comments"^^xsd:string
    "github_get_repository"^^xsd:string
    "github_get_commit"^^xsd:string
    "github_list_commits"^^xsd:string
    "github_get_file_contents"^^xsd:string
    "github_list_branches"^^xsd:string
    "mcp-code-executor_execute_code"^^xsd:string 
  }

  ?tool rdf:type tc-ont:Tool ;
        tc-ont:hasMetadata ?tMeta .
  
  ?tMeta tc-ont:hasName ?toolName .
  
  OPTIONAL { 
    ?tMeta tc-ont:hasDescription ?toolDescription .
  }

  ?server tc-ont:hasTool ?tool .
  
  OPTIONAL { 
    ?server tc-ont:hasMetadata/tc-ont:hasName ?serverName .
  }
}
ORDER BY ?serverName ?toolName
